/*
 * Settings still handled here
 *
 * These are read before Galette can reach database, so they cannot live
 * anywhere else.
 */

/**
 * Enable debug mode
 */
//define('GALETTE_DEBUG', true);

/**
 * Change mode
 *
 * Usable values are:
 * - PROD
 * - DEV (deprecated since 1.1.0, use GALETTE_DEBUG)
 * - MAINT (only super-admin can login)
 * - DEMO (superadmin credentials and mail settings are locked)
 */
//define('GALETTE_MODE', 'MAINT');

/**
 * Log level, as an Analog level. Defaults to WARNING, or DEBUG in debug mode.
 */
//define('GALETTE_LOG_LVL', \Analog\Analog::INFO);

/**
 * Dump every SQL query to data/logs/galette_sql.log
 *
 * Beware: the constant is tested for existence only, so defining it to false
 * still enables the dump.
 */
//define('GALETTE_SQL_DEBUG', true);

/*
 * Settings moved to the advanced configuration page
 *
 * Since 1.3.0 these are stored in database and reachable from
 * Configuration > Advanced configuration, as superadmin.
 *
 * Defining one here still works and still takes precedence over the stored
 * value, but the advanced page will show it as locked and Galette will log a
 * warning. Prefer removing it from this file.
 */

/**
 * Your Galette instance URI, needed by cron scripts which have no incoming
 * request to guess it from.
 *
 * Now stored as pref_galette_url.
 */
//define('GALETTE_URI', 'https://galette.example.com');

/**
 * Read user IP addresses from the X-Forwarded-For header
 *
 * This is for applications sitting behind one or several proxies.
 *
 * Don't set it if the application doesn't sit behind a proxy, as it would
 * allow potential attackers to replace their IP addresses with anything,
 * increasing a bit their stealth (IP address don't mean that much anyway)
 *
 *  Typically each proxy will append its client's IP address to this header
 *  The value is the index of the IP address to consider, from the end
 *  of the header values, starting with 1. 0 disables the lookup.
 *
 * Hence the provided example is the simplest suitable for being behind
 *  a single reverse proxy
 *
 * Now stored as pref_x_forwarded_for_index.
 */
//define('GALETTE_X_FORWARDED_FOR_INDEX', 1);

/**
 * Hide Galette version from the pages footer
 *
 * Now stored as pref_hide_version.
 */
//define('GALETTE_HIDE_VERSION', true);

/**
 * Session cookie lifetime, in seconds. 0 means until the browser is closed.
 *
 * @see https://php.net/manual/en/session.configuration.php#ini.session.cookie-lifetime
 *
 * Now stored as pref_session_timeout.
 */
//define('GALETTE_TIMEOUT', 0);

/**
 * Feature flags to activate, among those declared in
 * includes/sys_config/feature_flags.inc.php
 *
 * They only apply when GALETTE_DEBUG is enabled.
 *
 * Now stored as pref_feature_flags, as a comma separated list.
 */
//define('GALETTE_FEATURE_FLAGS', ['acls', 'oauth2']);
