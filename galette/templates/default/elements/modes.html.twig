{% if login.isSuperAdmin() %}
    <span class="tooltip ui red icon circular label" title="{{ _T("You are actually logged-in as superadmin. Some functionnalities may not be available since this is *not* a regular member.") }}">
        <i class="shield icon" aria-hidden="true"></i>
        {{ _T("Superadmin") }}
    </span>
{% endif %}
{% if callstatic('\\Galette\\Core\\Galette', 'isDemo') %}
    <span class="tooltip ui orange icon circular label" title="{{ _T("This application runs under DEMO mode, all features may not be available.") }}">
        <i class="gamepad icon" aria-hidden="true"></i>
        {{ _T("Demonstration") }}
    </span>
{% endif %}
{% if callstatic('\\Galette\\Core\\Galette', 'isUnderMaintenance') %}
    <span class="tooltip ui orange icon circular label" title="{{ _T("Galette is currently under maintenance!") }}">
        <i class="tools icon" aria-hidden="true"></i>
        {{ _T("Maintenance") }}
    </span>
{% endif %}
{% set two_factor_suspended_until = callstatic('\\Galette\\Core\\TwoFactorAuth', 'suspendedUntil', preferences) %}
{% if two_factor_suspended_until is not null and (login.isSuperAdmin() or login.isAdmin() or login.isStaff()) %}
    <span class="tooltip ui orange icon circular label" title="{{ _T("Two-factor authentication is suspended until %1$s: members log in with their password alone. It resumes on its own, or with galette:twofactor:suspend --resume.")|format(two_factor_suspended_until|date(_T("Y-m-d H:i:s"))) }}">
        <i class="unlock icon" aria-hidden="true"></i>
        {{ _T("Two-factor suspended") }}
    </span>
{% endif %}
