    <div class="ui basic fitted segment">
        <a
            href="{{ url_for('addDynamicField', {'form_name': form_name}) }}"
            class="ui labeled icon button addfield"
        >
            <i class="plus green icon" aria-hidden="true"></i>
            {{ _T("Add") }}
        </a>
    </div>
    <div class="ui basic fitted segment loader_selector">
        <table class="listing ui celled striped table">
            <thead>
                <tr>
                    <th scope="col" class="id_row collapsing">#</th>
                    <th scope="col">{{ _T("Name") }}</th>
                    <th scope="col">{{ _T("Permissions") }}</th>
                    <th scope="col" class="date_row">{{ _T("Type") }}</th>
                    <th scope="col" class="date_row{% if preferences.pref_member_form_grid == 'one' %} collapsing{% endif %}">{{ _T("Required") }}</th>
{% if preferences.pref_member_form_grid != 'one' %}
                    <th scope="col" class="date_row collapsing">{{ _T("Width in forms") }}</th>
{% endif %}
                    <th scope="col" class="collapsing">{{ _T("Actions") }}</th>
                </tr>
            </thead>
            <tbody>
{% for field in fields_list %}
                <tr>
                    <td class="collapsing" data-scope="id">{{ field.getIndex() }}</td>
                    <td class="left" data-scope="row">{{ field.getName()|escape }}</td>
                    <td class="left" data-col-label="{{ _T("Permissions") }}">{{ field.getPermissionName() }}</td>
                    <td class="left" data-col-label="{{ _T("Type") }}">{{ field.getTypeName() }}</td>
                    <td{% if preferences.pref_member_form_grid == 'one' %} class="collapsing"{% endif %} data-col-label="{{ _T("Required") }}">
    {% if field.getType != 0 %}
        {% if field.isRequired() %}{{ _T("Yes") }}{% else %}{{ _T("No") }}{% endif %}
    {% endif %}
                    </td>
    {% if preferences.pref_member_form_grid != 'one' %}
                    <td class="left collapsing" data-col-label="{{ _T("Width in forms") }}">
        {% if preferences.pref_member_form_grid == 'three' and field.getWidthInForms() == 3  %}
                        {{ _T("Half") }}
        {% elseif field.getWidthInForms() == 2 %}
                        {{ _T("Full") }}
        {% else %}
                        {{ _T("Default") }}
        {% endif %}
                    </td>
    {% endif %}
                    <td class="center actions_row collapsing">
                        <a
                            href="{{ url_for('editDynamicField', {'form_name': form_name, 'id': field.getId()}) }}"
                            class="action single-edit icon-only"
                        >
                            <i class="ui user edit blue icon" aria-hidden="true"></i>
                            <span class="visually-hidden">{{ _T("Edit '%s' field")|replace({'%s': field.getName()}) }}</span>
                        </a>
                        <a
                            href="{{ url_for('dynamicTranslations', {'text_orig': field.getName(false)}) }}"
                            class="action single-translate icon-only"
                        >
                            <i class="ui language grey icon" aria-hidden="true"></i>
                            <span class="visually-hidden">{{ _T("Translate '%s' field")|replace({'%s': field.getName()}) }}</span>
                        </a>
                        <a
                            href="{{ url_for('removeDynamicField', {'form_name': form_name, 'id': field.getId()}) }}"
                            class="delete icon-only"
                        >
                            <i class="ui trash red icon" aria-hidden="true"></i>
                            <span class="visually-hidden">{{ _T("Delete '%s' field")|replace({'%s': field.getName()}) }}</span>
                        </a>
    {% if field.getIndex() == 1 %}
                        <i class="ui icon">&nbsp;</i>
    {% else %}
                        <a
                            href="{{ url_for('moveDynamicField', {'form_name': form_name, 'direction': 'up', 'id': field.getId()}) }}"
                            class="icon-only"
                        >
                            <i class="ui caret up grey icon" aria-hidden="true"></i>
                            <span class="visually-hidden">{{ _T("Move up '%s' field")|replace({'%s': field.getName()}) }}</span>
                        </a>
    {% endif %}
    {% if field.getIndex() == fields_list|length %}
                        <i class="ui icon">&nbsp;</i>
    {% else %}
                        <a
                            href="{{ url_for('moveDynamicField', {'form_name': form_name, 'direction': 'down', 'id': field.getId()}) }}"
                            class="icon-only"
                        >
                            <i class="ui caret down grey icon" aria-hidden="true"></i>
                            <span class="visually-hidden">{{ _T("Move down '%s' field")|replace({'%s': field.getName()}) }}</span>
                        </a>
    {% endif %}
                    </td>
                </tr>
{% else %}
                <tr>
                    <td colspan="7">
                        {{ _T("There is not yet any dynamic field configured for '%formname'")|replace({'%formname': form_title}) }}
                    </td>
                </tr>
{% endfor %}
            </tbody>
        </table>
    </div>
    <script type="text/javascript">
        {% include "elements/js/removal.js.twig" with {
            single_action: "true"
        } %}
    </script>
