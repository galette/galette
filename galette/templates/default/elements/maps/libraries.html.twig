{#
 # Map libraries. Pages opening a map in a modal pass lazy_gl: the MapLibre
 # bundle is then loaded only when a vector background is displayed.
 #}
{% set locate = maps_locate ?? false %}
    <script nonce="{{ csp_nonce() }}" type="text/javascript" src="{{ base_path() }}/assets/js/maps.min.js"></script>
{% if tiles.vector and not (lazy_gl ?? false) %}
    {# a megabyte of MapLibre, only worth loading for a vector background #}
    <script nonce="{{ csp_nonce() }}" type="text/javascript" src="{{ base_path() }}/assets/js/maps-gl.min.js"></script>
{% endif %}
{% if locate %}
    <script nonce="{{ csp_nonce() }}" type="text/javascript" src="{{ base_path() }}/assets/js/maps-locate.min.js"></script>
{% endif %}
{% if lazy_gl ?? false %}
    {# pages opening maps in a modal: texts needed before any map is loaded #}
    <script nonce="{{ csp_nonce() }}" type="application/json" id="maps-page-strings">{{ {
        open_error: _T("The map could not be loaded."),
        retry: _T("Retry"),
        close: _T("Close")
    }|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
{% endif %}
