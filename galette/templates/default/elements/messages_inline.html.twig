{# Flash messages, rendered once, server side. On a regular page they are
 # hidden by the inline script below, and `common.js` turns each of them into a
 # Fomantic toast; browsers without javascript get them as they are (see
 # `elements/noscript.html.twig`).
 # `standalone` skips the `messages` id and that script: the markup is then
 # displayed as it is, which is what an ajax fragment needs.
 #}
{% set standalone = standalone ?? false %}

{# Let's see if there are loginfault messages to show #}
{% set loginfaults = flash.getMessage('loginfault') %}
{% if loginfault_detected is defined and loginfault_detected is iterable %}
    {% for l in loginfault_detected %}
        {% set loginfaults = loginfaults|merge([l]) %}
    {% endfor %}
{% endif %}

{# Let's see if there are error messages to show #}
{% set errors = flash.getMessage('error_detected') ?? [] %}
{% set errors = errors|merge(flash.getMessage('error') ?? []) %}
{% set errors = errors|merge(loginfaults ?? []) %}
{% if error_detected is defined and error_detected is iterable %}
    {% for e in error_detected %}
        {% set errors = errors|merge([e]) %}
    {% endfor %}
{% endif %}

{# Let's see if there are warning messages to show #}
{% set warnings = flash.getMessage('warning_detected') ?? [] %}
{% set warnings = warnings|merge(flash.getMessage('warning') ?? []) %}
{% if warning_detected is defined and warning_detected is iterable %}
    {% for w in warning_detected %}
        {% set warnings = warnings|merge([w]) %}
    {% endfor %}
{% endif %}

{# Let's see if there are success messages to show #}
{% set success = flash.getMessage('success_detected') ?? [] %}
{% set success = success|merge(flash.getMessage('success') ?? []) %}
{% if success_detected is defined and success_detected is iterable %}
    {% for entry in success_detected %}
        {% set success = success|merge([entry]) %}
    {% endfor %}
{% endif %}

{# Let's see if there are info messages to show #}
{% set info = flash.getMessage('info_detected') ?? [] %}
{% set info = info|merge(flash.getMessage('info') ?? []) %}
{% if info_detected is defined and info_detected is iterable %}
    {% for i in info_detected %}
        {% set info = info|merge([i]) %}
    {% endfor %}
{% endif %}

{% if errors|length > 0 or warnings|length > 0 or success|length > 0 or info|length > 0 %}
    <div{% if not standalone %} id="messages"{% endif %} role="alert">
    {% for error in errors %}
        <div class="ui error icon message" data-toast-class="error" data-toast-icon="exclamation circle" data-toast-persistent="true">
            <i class="exclamation circle icon" aria-hidden="true"></i>
            <div class="content">{{ error|raw }}</div>
        </div>
    {% endfor %}
    {% for warning in warnings %}
        <div class="ui warning icon message" data-toast-class="warning" data-toast-icon="exclamation triangle" data-toast-persistent="true">
            <i class="exclamation triangle icon" aria-hidden="true"></i>
            <div class="content">{{ warning|raw }}</div>
        </div>
    {% endfor %}
    {% for entry in success %}
        <div class="ui success icon message" data-toast-class="success" data-toast-icon="check circle outline">
            <i class="check circle outline icon" aria-hidden="true"></i>
            <div class="content">{{ entry|raw }}</div>
        </div>
    {% endfor %}
    {% for entry in info %}
        <div class="ui info icon message" data-toast-class="info" data-toast-icon="info">
            <i class="info icon" aria-hidden="true"></i>
            <div class="content">
            {% if entry is iterable %}
                <div class="header">{{ entry.title }}</div>
                {{ entry.message|raw }}
            {% else %}
                {{ entry|raw }}
            {% endif %}
            </div>
        </div>
    {% endfor %}
    </div>
    {% if not standalone %}
    <script>
        (function () {
            var _messages = document.getElementById('messages');

            {# Hidden from here rather than from the stylesheet: a rule in the
             # CSS would still apply when the bundle fails to load, and would
             # then cost the user every message without a trace. #}
            _messages.style.display = 'none';

            {# `common.js` turns them into toasts and drops the container. If it
             # never ran, it is still there once everything else has loaded, and
             # the messages are shown as they are. #}
            window.addEventListener('load', function () {
                window.setTimeout(function () {
                    if (_messages.parentNode) {
                        _messages.style.display = '';
                    }
                }, 0);
            });
        })();
    </script>
    {% endif %}
{% endif %}

{# Renew telemetry #}
{% if renew_telemetry is defined and renew_telemetry %}
    {% include "modals/telemetry.html.twig" with {part: "dialog"} %}
{% endif %}
