{#
 # Members and managers of the group, one row per person.
 #
 # Persons are added to the table without being stored; unchecked or disabled
 # checkboxes are not posted, so members[] and managers[] carry exactly the
 # persons to store. The empty values are always posted, so that an emptied
 # list is stored as such.
 #}
{% set can_edit_persons = group.canEdit(login) and permission_scope('member:read') == 'all' %}
{% set group_managers = group.getManagers() %}
{% set group_members = group.getMembers() %}
{% set manager_ids = group_managers|map(p => p.id) %}
{% set member_ids = group_members|map(p => p.id) %}
{% set persons = group_managers|merge(group_members|filter(p => p.id not in manager_ids))|sort((a, b) => a.sname|lower <=> b.sname|lower) %}
    <div id="group_persons" class="ui basic fitted segment">
        <div class="ui styled fluid accordion row">
            <div class="active title">
                <i class="icon dropdown" aria-hidden="true"></i>
                {{ _T("Members") }} ({{ group_members|length }}) - {{ _T("Managers") }} ({{ group_managers|length }})
            </div>
            <div class="active content field">
{% if can_edit_persons %}
                <input type="hidden" name="members[]" value=""/>
                <input type="hidden" name="managers[]" value=""/>
{% endif %}
                <table class="listing ui celled striped table" id="group_persons_list">
                    <caption class="visually-hidden">{{ _T("Members") }}</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="left">{{ _T("Name") }}</th>
                            <th scope="col" class="left">{{ _T("Nickname") }}</th>
                            <th scope="col" class="center aligned collapsing">{{ _T("Member of group") }}</th>
                            <th scope="col" class="center aligned collapsing">{{ _T("Group manager") }}</th>
                            <th scope="col" class="collapsing"><span class="visually-hidden">{{ _T("Actions") }}</span></th>
                        </tr>
                    </thead>
                    <tbody>
{% for person in persons %}
    {% include "elements/group_person_row.html.twig" with {
        'is_member': person.id in member_ids,
        'is_manager': person.id in manager_ids,
        'linked': true
    } %}
{% endfor %}
                        <tr id="group_persons_empty"{% if persons|length > 0 %} hidden{% endif %}>
                            <td colspan="5" class="emptylist">{{ _T("No member attached") }}</td>
                        </tr>
                    </tbody>
                </table>
{% if can_edit_persons %}
                <div class="fields">
                    {% include 'components/forms/member_dropdown.html.twig' with {
                        'label': _T("Add a member"),
                        'id': 'person_add',
                        'value': null,
                        'component_class': 'twelve wide field'
                    } %}
                    <div class="four wide field">
                        <label aria-hidden="true">&nbsp;</label>
                        <button type="button" id="person_add_btn" class="ui fluid labeled icon button">
                            <i class="plus green icon" aria-hidden="true"></i>
                            {{ _T("Add") }}
                        </button>
                    </div>
                </div>
{% endif %}
                <div id="group_persons_status" aria-live="polite">
                    <div class="ui small visible warning message displaynone">
                        <i class="info circle icon" aria-hidden="true"></i>
                        {{ _T("Items in this list have been modified. Don't forget to save your changes.") }}
                    </div>
                </div>
            </div>
        </div>
    </div>
