{% extends (mode == 'ajax') ? "ajax.html.twig" : "page.html.twig" %}

{% if step == 'perms' %}
    {% set approve_text = _T("Retry") %}
{% elseif install.isUpgrade() %}
    {% set approve_text = _T("Update") %}
{% else %}
    {% set approve_text = _T("Install") %}
{% endif %}

{% block content %}
    <div id="plugins_initdb_ajax">
        <form action="{{ url_for('pluginInitDb', {'id': plugid}) }}" id="plugins_initdb_form" method="post" class="ui form" data-approve="{{ approve_text }}">
            {% if mode != 'ajax' %}<h2>{{ page_title }}</h2>{% endif %}
            {% if mode == 'ajax' %}
                {% include 'elements/messages_inline.html.twig' with {standalone: true} %}
            {% endif %}
    {% if step == 'confirm' %}
        {% if install.isUpgrade() %}
            <p>{{ _T("Database of plugin '%1$s' will be upgraded from version %2$s to version %3$s.")|format(plugin.name, installed_version, plugin.dbversion) }}</p>
        {% else %}
            <p>{{ _T("Database of plugin '%1$s' will be installed.")|format(plugin.name) }}</p>
        {% endif %}
            <div class="ui icon yellow message">
                <i class="exclamation triangle icon" aria-hidden="true"></i>
                <div class="content">
                    {{ _T("Warning: Don't forget to backup your current database.") }}
                </div>
            </div>
    {% endif %}
    {% if step == 'perms' %}
            <div class="ui red message">
        {% if not db_checks.supported %}
                <p>{{ _T("Incompatible database version.") }}</p>
                <p>{{ unsupported_message }}</p>
        {% elseif install.isUpgrade() %}
                <p>{{ _T("GALETTE hasn't got enough permissions on the database to continue the update.") }}</p>
        {% else %}
                <p>{{ _T("GALETTE hasn't got enough permissions on the database to continue the installation.") }}</p>
        {% endif %}
            </div>
        {% if db_checks.checks|length > 0 %}
            <ul class="leaders">
            {% for check in db_checks.checks %}
                <li>
                    <span>{{ check.message }}</span>
                    <span>{{ install.getValidationImage(check.res)|raw }}</span>
                </li>
            {% endfor %}
            </ul>
        {% endif %}
    {% endif %}
    {% if step == 'done' %}
        {% if success %}
            <div class="ui green message">
            {% if install.isUpgrade() %}
                {{ _T("Plugin '%1$s' has been successfully updated!")|format(plugin.name) }}
            {% else %}
                {{ _T("Plugin '%1$s' has been successfully installed!")|format(plugin.name) }}
            {% endif %}
            </div>
        {% else %}
            <div class="ui red message">
                <p>{{ _T("The tables have not been totally created, it may be a permission problem.") }}</p>
            {% if install.isUpgrade() %}
                <p>{{ _T("Your database is maybe not usable, try to restore the older version.") }}</p>
            {% endif %}
            </div>
        {% endif %}
        {% if report|length > 0 %}
            <div class="ui styled fluid accordion">
                <div class="{% if not success %}active {% endif %}title">
                    <i class="icon dropdown" aria-hidden="true"></i>
                    {{ _T("Details") }}
                </div>
                <div class="{% if not success %}active {% endif %}content">
                    <p>{{ _T("(Errors on DROP and RENAME operations can be ignored)") }}</p>
                    <ul class="leaders">
                    {% for entry in report %}
                        <li>
                            <span>
                                {{ entry.message }}
                                {% if entry.debug is defined %}<br/><em>{{ entry.debug }}</em>{% endif %}
                            </span>
                            <span>{{ install.getValidationImage(entry.res)|raw }}</span>
                        </li>
                    {% endfor %}
                    </ul>
                </div>
            </div>
        {% endif %}
    {% endif %}
            <div class="ui basic fitted right aligned segment form-actions">
    {% if step != 'done' %}
                <input type="hidden" name="confirm" value="1"/>
        {% if mode != 'ajax' %}
                <button id="next" class="ui labeled icon primary button" type="submit"><i class="forward icon" aria-hidden="true"></i> {{ approve_text }}</button>
        {% endif %}
    {% elseif mode != 'ajax' %}
                <a href="{{ url_for('plugins') }}" class="ui labeled icon button" id="btnback"><i class="backward icon" aria-hidden="true"></i> {{ _T("Back to plugins management page") }}</a>
    {% endif %}
            </div>
        </form>
    </div>
{% endblock %}
