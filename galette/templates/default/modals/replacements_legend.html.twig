<div id="legende{{ cur_ref }}" class="texts_legend ui large modal" title="{{ _T("Existing variables") }}">
    <div class="header">{{ _T('Existing variables') }}</div>
    <div class="scrolling content">
        <table class="ui very basic table">
    {% for legend in legends %}
        <tr>
            <th scope="colgroup" colspan="4">
                {{ legend.title }}
            </th>
        </tr>
        {% for pattern in legend.patterns %}
            {% if loop.index0 % 2 == 0 %}
                <tr>
            {% endif %}
            <th scope="row"><code>{{ pattern.pattern|trim('/') }}</code></th>
            <td class="back">
                {% if pattern.title is defined %}{{ pattern.title }}{% endif %}
            </td>
            {% if loop.index0 % 2 != 0 %}
                </tr>
            {% endif %}
        {% endfor %}
    {% endfor %}
        </table>
    </div>
    <div class="actions"><div class="ui labeled icon deny button"><i class="times icon" aria-hidden="true"></i> {{ _T('Close') }}</div></div>
</div>
<script type="text/javascript">

    /* The control opening the legend is a button: an <i> has no role, takes no
     * focus and answers no key, so the icon it used to be was reachable with a
     * mouse only. Built with jQuery rather than concatenated, so the label
     * reaches the attribute and the text node whatever it holds.
     */
    var _addLegendButton = function(selector) {
        var label = '{{ _T("Show existing variables")|e('js') }}';

        $(selector).append(
            $('<button type="button" class="btnlegend ui question tooltip icon-only link button"/>')
                .attr('title', label)
                .append('<i class="circular basic question icon" aria-hidden="true"></i>')
                .append($('<span class="visually-hidden"/>').text(label))
        );
    };

    var _handleLegend = function(selector) {
        if (typeof selector == 'undefined') {
            selector = '{{ cur_ref }}';
        }
        $('#legende' + selector).modal().modal('hide');

        $('.btnlegend').unbind('click').click(function(){
            $('#legende' + selector).modal('show');
            return false;
        });
    };
</script>
