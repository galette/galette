{% if object.getDynamicFields() is not empty %}
    {% set fields = object.getDynamicFields().getFields() %}
    {% set masschange = masschange ?? false %}

    {% if fields is not empty %}

        {% macro draw_field(field, field_data, disabled, idx, object, masschange, required, removable) %}
            {% set valuedata = field_data.field_val|escape %}
            {% if masschange %}
                {# Add a checkbox for fields to change on mass edition #}
                <span class="ui checkbox masschange">
                    <input type="checkbox" name="mass_info_field_{{ field.getId() }}" class="mass_checkbox"/>
                </span>
            {% endif %}
            {% if get_class(field) == 'Galette\\DynamicFields\\File' %}
                <label>
                    {{ field.getName()|escape }}
                    {# a loose comparison, so the __IDX__ placeholder of the pristine template keeps its number #}
                    {% if idx != 1 %}({{ idx }}){% endif %}
                </label>
                {% include "components/forms/max_size.html.twig" with {
                    max_size: field.getSize() ?: preferences.pref_upload_size_dynamic_files,
                    input_id: 'info_field_' ~ field.getId() ~ '_' ~ idx ~ '_new'
                } %}
            {% elseif get_class(field) != 'Galette\\DynamicFields\\Boolean' %}
                <label for="info_field_{{ field.getId() }}_{{ idx }}">
                    {{ field.getName()|escape }}
                    {# a loose comparison, so the __IDX__ placeholder of the pristine template keeps its number #}
                    {% if idx != 1 %}({{ idx }}){% endif %}
                </label>
            {% endif %}
            {% if removable %}
                {#
                 # The button sits on the label's line, so an occurrence does not take
                 # a row more than a plain field. Javascript shows it once there is
                 # something to remove, and binds it. A stored file goes away for good,
                 # where an empty occurrence is only one row less.
                 #}
                {% set drops_file = get_class(field) == 'Galette\\DynamicFields\\File' and object.id and valuedata %}
                {% set remove_label = (drops_file ? _T("Delete the file and remove this occurrence of %1$s") : _T("Remove this occurrence of %1$s"))|format(field.getName()) %}
                <button
                    type="button"
                    class="jsonly displaynone ui tiny basic red icon button repeat_remove"
                    aria-label="{{ remove_label }}"
                    title="{{ remove_label }}"
                ><i class="{{ drops_file ? 'trash alternate' : 'minus' }} icon" aria-hidden="true"></i></button>
            {% endif %}
            {% if field.getInformation() and field.hasInformationAbove() %}
                <div class="field-description">{{ field.getInformation()|raw }}</div>
            {% endif %}
            {% if get_class(field) == 'Galette\\DynamicFields\\Text' %}
                <textarea name="info_field_{{ field.getId() }}_{{ idx }}" id="info_field_{{ field.getId() }}_{{ idx }}"
                    cols="{% if field.getWidth() > 0 %}{{ field.getWidth() }}{% else %}61{% endif %}"
                    rows="{% if field.getHeight() > 0 %}{{ field.getHeight() }}{% else %}6{% endif %}"
                    {% if required %} required="required"{% endif %}
                    {% if disabled %} disabled="disabled"{% endif %}>{{ valuedata|raw }}</textarea>
            {% elseif get_class(field) == 'Galette\\DynamicFields\\Line' %}
                <input type="text" name="info_field_{{ field.getId() }}_{{ idx }}" id="info_field_{{ field.getId() }}_{{ idx }}"
                    {% if field.getWidth() > 0 %}size="{{ field.getWidth() }}"{% endif %}
                    {% if field.getSize() > 0 %}maxlength="{{ field.getSize() }}"{% endif %}
                    {% if field.getMinSize() > 0 %}minlength="{{ field.getMinSize() }}"{% endif %}
                    value="{{ valuedata|raw }}"
                    {% if required %} required="required"{% endif %}
                    {% if disabled %} disabled="disabled"{% endif %}
                />
            {% elseif get_class(field) == 'Galette\\DynamicFields\\Choice' %}
                <select name="info_field_{{ field.getId() }}_{{ idx }}" id="info_field_{{ field.getId() }}_{{ idx }}"
                    {% if required %} required="required"{% endif %}
                    {% if disabled %} disabled="disabled"{% endif %}
                    >
                    <!-- If no option is present, page is not XHTML compliant -->
                    <option value="">{{ _T("Select an option") }}</option>
                    {% for key, value in field.getValues() %}
                        <option value="{{ key }}"{% if key == valuedata %} selected="selected"{% endif %}>{{ value }}</option>
                    {% endfor %}
                </select>
            {% elseif get_class(field) == 'Galette\\DynamicFields\\Date' %}
                <div id="dynamic_date_{{ field.getId() }}_{{ idx }}_rangestart" class="ui calendar">
                    <div class="ui fluid input left icon">
                        <i class="calendar icon" aria-hidden="true"></i>
                        <input type="text" name="info_field_{{ field.getId() }}_{{ idx }}" id="info_field_{{ field.getId() }}_{{ idx }}" maxlength="10"
                            value="{{ valuedata }}" class="dynamic_date modif_date" placeholder="{{ _T("yyyy-mm-dd format") }}"
                            {% if required %} required="required"{% endif %}
                            {% if disabled %} disabled="disabled"{% endif %}
                        />
                    </div>
                </div>
            {% elseif get_class(field) == 'Galette\\DynamicFields\\Boolean' %}
                <div class="ui toggle right aligned checkbox">
                    <input type="checkbox" name="info_field_{{ field.getId() }}_{{ idx }}" id="info_field_{{ field.getId() }}_{{ idx }}" value="1"
                        {% if valuedata == 1%} checked="checked"{% endif %}
                        {% if required %} required="required"{% endif %}
                        {% if disabled %} disabled="disabled"{% endif %}
                    />
                    <label for="info_field_{{ field.getId() }}_{{ idx }}">
                        {{ field.getName()|escape }}
                    </label>
                </div>
            {% elseif get_class(field) == 'Galette\\DynamicFields\\File' %}
                {% if object.id and valuedata %}
                <a href="{{ url_for("getDynamicFile", {"form_name": object.getFormName(), "id": object.id, "fid": field.getId(), "pos": idx, "name": valuedata}) }}">
                    {{ valuedata }}
                    <i class="external alternate icon" aria-hidden="true"></i>
                </a>
                {% endif %}
                <div class="extra ui basic fitted segment">
                    <div class="ui file action input">
                        <input
                            type="file"
                            name="info_field_{{ field.getId() }}_{{ idx }}"
                            id="info_field_{{ field.getId() }}_{{ idx }}_new"
                            aria-describedby="info_field_{{ field.getId() }}_{{ idx }}_new-max-size"
                            {% if required and valuedata == '' %} required="required"{% endif %}
                            {% if disabled %} disabled="disabled"{% endif %}
                        />
                        <label for="info_field_{{ field.getId() }}_{{ idx }}_new" class="ui button">
                            <i class="blue upload icon" aria-hidden="true"></i>
                            {% if object.id and valuedata %}{{ _T("Choose another file") }}{% else %}{{ _T("Choose a file") }}{% endif %}
                        </label>
                    </div>
                </div>
            {% endif %}
            {% if field.getInformation() and not field.hasInformationAbove() %}
                <div class="field-description">{{ field.getInformation()|raw }}</div>
            {% endif %}
        {% endmacro %}

        <div class="ui styled fluid accordion field">
            <div class="active title">
                <i class="jsonly displaynone icon dropdown" aria-hidden="true"></i>
                {{ _T("Additionnal fields:") }}
            </div>
            <div class="active content field">
                <div class="ui{% if preferences.pref_member_form_grid is defined %} {{ preferences.pref_member_form_grid }}{% endif %} column stackable grid">
                {% set access_level = login.getAccessLevel() %}
                {% for field in fields %}
                    {% set perm = field.getPermission() %}
                    {% if get_class(field) == 'Galette\\DynamicFields\\Separator' %}
                    <div class="sixteen wide column">
                        <div class="ui horizontal divider">{{ field.getName()|escape }}</div>
                    </div>
                    {% elseif (get_class(field) == 'Galette\\DynamicFields\\File' or field.isRepeatable()) and masschange %}
                        <!-- File and repeatable fields not shown in mass changes form -->
                    {% else %}
                        {% set disabled = false %}
                        {% if perm == constant('Galette\\Entity\\FieldsConfig::USER_READ') and access_level == constant('Galette\\Core\\Authentication::ACCESS_USER') %}
                            {% set disabled = true %}
                        {% endif %}
                        {% set is_file = get_class(field) == 'Galette\\DynamicFields\\File' %}
                        {% set values = object.getDynamicFields().getValues(field.getId()) %}
                        {# a field takes several occurrences when its repeat is greater than one, or zero (as many as wanted); a null or single repeat means it takes a single one #}
                        {% set repeatable = not masschange and field.isRepeatable() %}
                        {% if is_file or field.isRepeatable() %}
                          {% set columns = 'sixteen wide ' %}
                        {% elseif field.getWidthInForms() == 1 or (preferences.pref_member_form_grid == 'two' and field.getWidthInForms() == 3) %}
                          {% set columns = '' %}
                        {% else %}
                          {% set columns = (field.getWidthInForms() == 3) ? 'eight wide ' : 'sixteen wide ' %}
                        {% endif %}
                        {# a lone file field has no occurrence to add, but its stored file can be dropped #}
                        <div class="{% if repeatable %}repeatable {% elseif is_file %}dynfiles {% endif %}{{ columns }}column"{% if repeatable %} data-maxrepeat="{{ field.getRepeat() }}"{% endif %}>
                            {% for field_data in values %}
                                {# the occurrence is numbered after its stored index, which the form posts back and the file names carry #}
                                {% set idx = field_data.val_index %}
                                {% set required = field.isRequired() and (not repeatable or idx == 1) %}
                                {# a stored file is dropped from its own occurrence, repeatable or not #}
                                {% set removable = repeatable or (is_file and object.id and field_data.field_val) %}
                                <div class="field{% if removable %} removable{% endif %}{% if required %} required{% endif %}{% if is_file %} wide{% endif %}"{% if field_data.field_val %} data-filled="1"{% endif %}>
                                    {{ _self.draw_field(field, field_data, disabled, idx, object, masschange, required and not masschange, removable) }}
                                </div>
                            {% endfor %}
                            {% if values is not iterable or values|length == 0 %}
                                {% set required = field.isRequired() %}
                                <div class="field{% if repeatable %} removable{% endif %}{% if required %} required{% endif %}{% if is_file %} wide{% endif %}">
                                    {{ _self.draw_field(field, {'field_val': ''}, disabled, 1, object, masschange, required and not masschange, repeatable) }}
                                </div>
                            {% endif %}
                            {% if repeatable %}
                                {# the javascript keeps this message in sync with the occurrences count #}
                                <p class="field-description repeat_msg" aria-live="polite">
                                    {%- if field.getRepeat() == 0 -%}
                                        {{ _T("Enter as many occurrences you want.") }}
                                    {%- endif -%}
                                </p>
                                {#
                                 # Pristine markup used by javascript to add a new occurrence:
                                 # this way, added occurrences keep their label and information text.
                                 # __IDX__ is replaced with the occurrence number.
                                 #}
                                <template
                                    class="repeat_template"
                                    data-add-label="{{ _T("Add an occurrence of %1$s")|format(field.getName())|escape }}"
                                >
                                    <div class="field removable">
                                        {{ _self.draw_field(field, {'field_val': ''}, disabled, '__IDX__', object, masschange, false, true) }}
                                    </div>
                                </template>
                            {% endif %}
                        </div>
                    {% endif %}
                {% endfor %}
                </div>
            </div>
        </div>
        {% if not masschange %}
            <script type="text/javascript">
                $(function() {
                    {# only used to (re)initialize calendars on added occurrences #}
                    {% include "elements/js/calendar.js.twig" with {selector: '.repeat_no_calendar'} %}

                    var _repeatMsg = '{{ _T("Enter up to %1$s more occurrences.")|format("__COUNT__")|e('js') }}';
                    {# once the stored file is gone, the upload control replaces nothing anymore #}
                    var _chooseFile = '{{ _T("Choose a file")|e('js') }}';

                    var _addButton = function(_label) {
                        return $('<button type="button" class="ui tiny green labeled icon button repeat_add"><i class="plus icon" aria-hidden="true"></i> {{ _T("Add")|e('js') }}</button>')
                            .attr('aria-label', _label);
                    };

                    var _getControl = function(_field) {
                        return _field.find('input, select, textarea').not('.mass_checkbox').first();
                    };

                    {# an occurrence holding a stored file: the file lives on the server, not in the form #}
                    var _holdsFile = function(_field) {
                        return _field.data('filled') && _field.find('input[type="file"]').length > 0;
                    };

                    {# every control of an occurrence is named after its index, files included #}
                    var _getIndex = function(_field) {
                        var _matches = (_getControl(_field).attr('name') || '').match(/_(\d+)$/);
                        return _matches ? parseInt(_matches[1], 10) : 0;
                    };

                    {# an index is never reused, so a removed occurrence leaves a hole the server compacts #}
                    var _nextIndex = function(_parent) {
                        var _index = 0;
                        _parent.children('.field').each(function() {
                            _index = Math.max(_index, _getIndex($(this)));
                        });
                        return _index + 1;
                    };

                    {# what is left to fill in counts occurrences, not indexes #}
                    var _refresh = function(_parent) {
                        var _fields = _parent.children('.field');
                        var _max = parseInt(_parent.attr('data-maxrepeat'), 10);

                        {#
                         # The buttons come hidden from the markup, for browsers without javascript.
                         # There is nothing to remove on a lone occurrence, unless it holds a file.
                         #}
                        _fields.children('.repeat_remove').removeClass('displaynone');
                        _fields.each(function() {
                            $(this).children('.repeat_remove')
                                .toggle(_fields.length > 1 || _holdsFile($(this)));
                        });

                        if (_max > 0) {
                            var _remaining = _max - _fields.length;
                            _parent.children('.repeat_add').toggle(_remaining > 0);
                            _parent.children('.repeat_msg')
                                .text(_remaining > 0 ? _repeatMsg.replace(/__COUNT__/, _remaining) : '')
                                .toggle(_remaining > 0);
                        }
                    };

                    $('.repeatable, .dynfiles').each(function() {
                        var _parent = $(this);
                        {# a file field that takes a single occurrence has none to add, and no template #}
                        var _template = _parent.children('template.repeat_template')[0];

                        {# drop trailing empty occurrences, but always keep one to fill in #}
                        var _fields = _parent.children('.field');
                        while (
                            _fields.length > 1
                            && !_fields.last().data('filled')
                            && !_getControl(_fields.last()).val()
                        ) {
                            _fields.last().remove();
                            _fields = _parent.children('.field');
                        }

                        {# delegated, so an occurrence added later needs no binding of its own #}
                        _parent.on('click', '.repeat_remove', function(e) {
                            e.preventDefault();

                            var _field = $(this).closest('.field');

                            {#
                             # A stored file is not posted back with the form, so dropping its
                             # occurrence from the page says nothing to the server. Leave the
                             # deletion behind, so the file goes away with its occurrence.
                             #}
                            if (_holdsFile(_field)) {
                                $('<input type="hidden" value="1" />')
                                    .attr('name', _getControl(_field).attr('name'))
                                    .appendTo(_parent);
                            }

                            if (_parent.children('.field').length > 1) {
                                _field.remove();
                            } else {
                                {# the last occurrence stays, to upload a file in place of the deleted one #}
                                _field.children('a').remove();
                                _field.removeAttr('data-filled').removeData('filled');
                                _field.find('.ui.file.input > label.ui.button')
                                    .contents().last().replaceWith(' ' + _chooseFile);
                            }

                            _refresh(_parent);
                        });

                        if (!_template) {
                            _refresh(_parent);
                            return;
                        }

                        var _add = _addButton($(_template).data('add-label'));
                        _parent.append(_add);
                        _add.on('click', function(e) {
                            e.preventDefault();

                            var _new = $(_template.innerHTML.replace(/__IDX__/g, _nextIndex(_parent)).trim());
                            _new.insertAfter(_parent.children('.field').last());

                            {# the pristine markup is raw: its widgets have never been bound #}
                            var _calendars = _new.find('.ui.calendar');
                            if (_calendars.length > 0) {
                                _calendarWidget(_calendars);
                            }
                            _new.find('select').dropdown();
                            _new.find('.ui.checkbox').checkbox();

                            _getControl(_new).trigger('focus');
                            _refresh(_parent);
                        });

                        _refresh(_parent);
                    });
                });
            </script>
        {% endif %}
    {% endif %}
{% endif %}
