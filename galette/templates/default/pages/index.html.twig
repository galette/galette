{% extends 'public_page.html.twig' %}

{% set body_class = "front_page" %}

{% block form_url %}{{ url_for('dologin') }}{% endblock %}

{% block content %}
                <form action="{{ block('form_url') }}" method="post" class="ui form">
    {% if preferences.pref_mail_method != constant('\\Galette\\Core\\GaletteMail::METHOD_DISABLED') %}
                    <div class="ui segments">
    {% endif %}
                        <div class="ui segment">
                            <div class="field">
                                <div class="ui left icon input">
                                    <i class="user icon" aria-hidden="true"></i><label for="login" class="visually-hidden">{{ _T("Username:") }}</label>
                                    <input type="text" name="login" id="login" autofocus placeholder="{{ _T("Username:") }}"/>
                                </div>
                            </div>
                            <div class="field">
                                <div class="ui left icon input">
                                    <i class="lock icon" aria-hidden="true"></i><label for="password" class="visually-hidden">{{ _T("Password:") }}</label>
                                    <input type="password" name="password" id="password" placeholder="{{ _T("Password:") }}"/>
                                </div>
                            </div>
                            <input type="submit" class="ui fluid large primary submit button" value="{{ _T("Login") }}"/>
                            <input type="hidden" name="ident" value="1" />
                        </div>
    {% if preferences.pref_mail_method != constant('\\Galette\\Core\\GaletteMail::METHOD_DISABLED') %}
                        <div class="ui center aligned secondary segment">
                            <a
                                href="{{ url_for('password-lost') }}"
                                class="password-lost"
                            >
                                <i class="icon unlock alternate" aria-hidden="true"></i>
                                {{ _T("Lost your password?") }}
                            </a>
                        </div>
                    </div>
    {% endif %}
                </form>
    {% set demo_accounts = callstatic('\\Galette\\Core\\Galette', 'getDemoAccounts') %}
    {% if demo_accounts is not empty %}
                <div class="ui segment demo-accounts">
                    <h2 class="ui small header">
                        <i class="gamepad icon" aria-hidden="true"></i>
                        <div class="content">
                            {{ _T("Demonstration accounts") }}
                            <div class="sub header">{{ _T("Log in with one of them to discover Galette.") }}</div>
                        </div>
                    </h2>
                    <div class="ui middle aligned divided relaxed list">
        {% for account in demo_accounts %}
                        <div class="item">
                            <form action="{{ url_for('dologin') }}" method="post" class="right floated content">
                                <input type="hidden" name="login" value="{{ account.login }}"/>
                                <input type="hidden" name="password" value="{{ account.password }}"/>
                                <input type="hidden" name="ident" value="1"/>
                                <button type="submit" class="ui small primary button" aria-label="{{ _T("Log in as %s")|replace({'%s': account.label}) }}">
                                    <i class="sign in alternate icon" aria-hidden="true"></i>
                                    {{ _T("Login") }}
                                </button>
                            </form>
                            <div class="content">
                                <div class="header">{{ account.label }}</div>
                                <div class="description">
                                    <code>{{ account.login }}</code> / <code>{{ account.password }}</code>
                                </div>
                            </div>
                        </div>
        {% endfor %}
                    </div>
                </div>
    {% endif %}
{% endblock %}
