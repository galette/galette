{% extends 'elements/list.html.twig' %}

{% block infoline %}
    {% set infoline = {
        'label': _Tn("%1$s search", "%1$s searches", nb)|format(nb),
    } %}
    {{ parent() }}
{% endblock %}

{% set columns = [
    {
        'label': _T('ID'),
        'collapse': true
    },
    {
        'label': _T("Creation date"),
        collapse: true
    },
    {
        'label': _T("Name"),
        collapse: true
    },
    {
        'label': _T("Parameters")
    }
] %}

{% block body %}
    {% for search in searches %}
        <tr>
            <td class="collapsing" data-scope="row" data-col-label="{{ _T('ID') }}">
                {{ search.id }}
            </td>
            <td class="left collapsing" data-col-label="{{ _T("Creation date") }}">{{ search.creation_date }}</td>
            <td class="left collapsing" data-col-label="{{ _T("Name") }}">{{ search.name|default("-") }}</td>
            <td class="left" data-col-label="{{ _T("Search parameters") }}">
                <details class="ui basic styled accordion">
                    <summary class="title">
                        <i class="caret down icon" aria-hidden="true"></i> {{ _T("Show parameters") }}
                    </summary>
                    <div class="content">
        {% for key, parameter in search.sparameters %}
                        <strong>{{ key }}:</strong> {{ parameter }}{% if not loop.last %}<br />{% endif %}
        {% endfor %}
                    </div>
                </details>
            </td>
            <td class="center actions_row collapsing">
                <a
                        href="{{ url_for("loadSearch", {"id": search.id}) }}"
                        class="icon-only"
                >
                    <i class="ui search icon" aria-hidden="true"></i>
                    <span class="visually-hidden">{{ _T("Load saved search") }}</span>
                </a>

                <a
                        href="{{ url_for("removeSearch", {"id": search.id}) }}"
                        class="delete icon-only"
                >
                    <i class="ui trash red icon" aria-hidden="true"></i>
                    <span class="visually-hidden">{{ _T("Remove saved search") }}</span>
                </a>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="{{ columns_count }}" class="emptylist">{{ _T("no search") }}</td></tr>
    {% endfor %}
{% endblock %}

{% block javascripts %}
        <script type="text/javascript">
            $(function() {
                {% include "elements/js/removal.js.twig" with {
                    single_action: "true"
                } %}
            });
        </script>
{% endblock %}
