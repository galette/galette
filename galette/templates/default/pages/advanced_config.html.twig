{% extends 'page.html.twig' %}

{% block content %}
        <div class="ui icon error message">
            <i class="exclamation triangle icon" aria-hidden="true"></i>
            <div class="content">
                <div class="header">{{ _T("- WARNING -") }}</div>
                <p>{{ _T("This page can break your installation, be very careful.") }}</p>
            </div>
        </div>

        <div class="ui basic fitted segment">
            <div class="ui fluid icon input">
                <label for="config_filter" class="visually-hidden">{{ _T("Filter settings") }}</label>
                <input type="search" id="config_filter" placeholder="{{ _T("Search a setting...") }}"/>
                <i class="search icon" aria-hidden="true"></i>
            </div>
        </div>

        <div class="ui basic right aligned fitted segment jsonly displaynone">
            <button type="button" class="show_legend ui blue tertiary button">{{ _T("Show legend") }}</button>
        </div>

        <table class="listing ui celled striped table" id="advanced_config">
            <thead>
                <tr>
                    <th>{{ _T("Name") }}</th>
                    <th class="collapsing">{{ _T("Type") }}</th>
                    <th class="collapsing">{{ _T("Status") }}</th>
                    <th>{{ _T("Value") }}</th>
                </tr>
            </thead>
            <tbody>
{% for entry in entries %}
                <tr data-name="{{ entry.name }}" id="{{ entry.name }}">
                    <td data-scope="row" data-col-label="{{ _T("Name") }}"><code>{{ entry.name }}</code></td>
                    <td class="collapsing" data-col-label="{{ _T("Type") }}">
                        {% if entry.known %}{{ entry.type }}{% else %}&mdash;{% endif %}
                    </td>
                    <td class="collapsing" data-col-label="{{ _T("Status") }}">
    {% if not entry.known %}
                        <span class="ui grey label" title="{{ _T("This setting is not known by Galette. It may come from an older version or from a plugin.") }}">{{ _T("unknown") }}</span>
    {% elseif entry.locked_by %}
                        <span class="ui red label" title="{{ _T("Set by the %s constant in behavior.inc.php, which takes precedence.")|replace({'%s': entry.locked_by}) }}">{{ _T("locked") }}</span>
    {% elseif entry.readonly %}
                        <span class="ui grey label" title="{{ _T("Galette maintains this value itself; it is shown for information only.") }}">{{ _T("read-only") }}</span>
    {% elseif entry.sensitive %}
                        <span class="ui grey label" title="{{ _T("Held as a secret: its value is never displayed, and it is changed from the settings form.") }}">{{ _T("secret") }}</span>
    {% elseif entry.is_default %}
                        <span class="ui basic label">{{ _T("default") }}</span>
    {% else %}
                        <span class="ui blue label">{{ _T("modified") }}</span>
    {% endif %}
    {% if entry.plugin %}
                        <span class="ui teal label" title="{{ _T("Declared by the %s plugin, and only while it stays active.")|replace({'%s': entry.plugin}) }}">{{ entry.plugin }}</span>
    {% endif %}
                    </td>
                    <td data-col-label="{{ _T("Value") }}">
    {% if not entry.known or entry.locked_by or entry.readonly %}
                        <code>{% if entry.value is not null %}{{ entry.value }}{% endif %}</code>
    {% elseif entry.sensitive %}
                        {% if entry.is_set %}{{ _T("set") }}{% else %}{{ _T("not set") }}{% endif %}
    {% else %}
                        <div class="advanced-config-actions">
                        <form id="cfg_{{ entry.name }}" action="{{ url_for('saveAdvancedConfig') }}" method="post" class="ui form advanced-config-form">
                            <input type="hidden" name="name" value="{{ entry.name }}"/>
                            <label for="value_{{ entry.name }}" class="visually-hidden">{{ entry.name }}</label>
                            <div class="ui action input">
        {% if entry.type == 'bool' %}
                            <input type="hidden" name="value" value="0"/>
                            <div class="ui toggle checkbox">
                                <input type="checkbox" id="value_{{ entry.name }}" name="value" value="1"{% if entry.value %} checked="checked"{% endif %}/>
                                <label for="value_{{ entry.name }}">{{ _T("Enabled") }}</label>
                            </div>
        {% elseif entry.type == 'int' %}
                            <input type="number" id="value_{{ entry.name }}" name="value" value="{{ entry.value }}"{% if entry.min is not null %} min="{{ entry.min }}"{% endif %}{% if entry.max is not null %} max="{{ entry.max }}"{% endif %}/>
        {% elseif entry.type == 'html' %}
                            <textarea id="value_{{ entry.name }}" name="value" rows="3">{{ entry.value }}</textarea>
        {% elseif entry.type == 'color' %}
                            <input type="color" id="value_{{ entry.name }}" name="value" value="{{ entry.value }}"/>
        {% elseif entry.type == 'url' %}
                            <input type="url" id="value_{{ entry.name }}" name="value" value="{{ entry.value }}"/>
        {% else %}
                            <input type="text" id="value_{{ entry.name }}" name="value" value="{{ entry.value }}"/>
        {% endif %}
                                <button type="submit" class="ui icon button" title="{{ _T("Save") }}">
                                    <i class="save icon" aria-hidden="true"></i>
                                    <span class="visually-hidden">{{ _T("Save '%s'")|replace({'%s': entry.name}) }}</span>
                                </button>
                            </div>
                        </form>
        {% if not entry.is_default %}
                        <form action="{{ url_for('resetAdvancedConfig') }}" method="post" class="ui form">
                            <button type="submit" class="ui icon button" title="{{ _T("Reset to default") }}">
                                <i class="undo icon" aria-hidden="true"></i>
                                <span class="visually-hidden">{{ _T("Reset '%s' to its default")|replace({'%s': entry.name}) }}</span>
                            </button>
                            <input type="hidden" name="name" value="{{ entry.name }}"/>
                        </form>
        {% endif %}
                        </div>
    {% endif %}
                    </td>
                </tr>
{% endfor %}
            </tbody>
        </table>

        <h2 class="ui dividing header">{{ _T("Constants behavior.inc.php understands") }}</h2>

        <div class="ui icon info message">
            <i class="file code icon" aria-hidden="true"></i>
            <div class="content">
                <p>{{ _T("Galette reads these from %s, so they cannot be edited from here. One marked deprecated is still declared there although a setting above replaces it, and overrides that setting until you remove it.")|replace({'%s': 'galette/config/behavior.inc.php'}) }}</p>
            </div>
        </div>

        <table class="listing ui celled striped table">
            <thead>
                <tr>
                    <th>{{ _T("Name") }}</th>
                    <th class="collapsing">{{ _T("Status") }}</th>
                    <th>{{ _T("Value") }}</th>
                    <th>{{ _T("Description") }}</th>
                </tr>
            </thead>
            <tbody>
{% for constant in constants %}
                <tr>
                    <td data-scope="row" data-col-label="{{ _T("Name") }}">
                        <code>{{ constant.name }}</code>
    {% if constant.replaced_by %}
                        <span class="ui orange label" title="{{ _T("Replaced by the \"%s\" setting.")|replace({'%s': constant.replaced_by}) }}">{{ _T("deprecated") }}</span>
    {% endif %}
                    </td>
                    <td class="collapsing" data-col-label="{{ _T("Status") }}">
    {% if constant.defined %}
                        <span class="ui blue label">{{ _T("defined") }}</span>
    {% else %}
                        <span class="ui basic label">{{ _T("not set") }}</span>
    {% endif %}
                    </td>
                    <td data-col-label="{{ _T("Value") }}">
    {% if constant.defined %}
                        <code>{{ constant.value }}</code>
    {% endif %}
                    </td>
                    <td data-col-label="{{ _T("Description") }}">
                        {{ constant.description }}
    {% if constant.replaced_by %}
                        <a href="#{{ constant.replaced_by }}" class="advanced-config-jump">
                            <i class="level down alternate icon" aria-hidden="true"></i>
                            {{ _T("Go to %s")|replace({'%s': constant.replaced_by}) }}
                        </a>
    {% endif %}
                    </td>
                </tr>
{% endfor %}
            </tbody>
        </table>

        <div id="legende" title="{{ _T("Legend") }}" class="ui modal">
            <div class="header">{{ _T("Legend") }}</div>
            <div class="content">
                <table class="ui stripped table">
                    <thead>
                        <tr>
                            <th scope="colgroup" colspan="2">{{ _T("Statuses") }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th scope="row"><span class="ui basic label">{{ _T("default") }}</span></th>
                            <td class="back">{{ _T("Never changed: the value Galette ships with.") }}</td>
                        </tr>
                        <tr>
                            <th scope="row"><span class="ui blue label">{{ _T("modified") }}</span></th>
                            <td class="back">{{ _T("Changed from the default, here or from the settings form. It can be reset.") }}</td>
                        </tr>
                        <tr>
                            <th scope="row"><span class="ui grey label">{{ _T("read-only") }}</span></th>
                            <td class="back">{{ _T("Galette maintains this value itself, such as a generated identifier or a date it records. It is shown for information only.") }}</td>
                        </tr>
                        <tr>
                            <th scope="row"><span class="ui grey label">{{ _T("secret") }}</span></th>
                            <td class="back">{{ _T("A password or a token. Its value is never displayed, only whether one is set, and it is changed from the settings form.") }}</td>
                        </tr>
                        <tr>
                            <th scope="row"><span class="ui red label">{{ _T("locked") }}</span></th>
                            <td class="back">{{ _T("A constant defined in behavior.inc.php takes precedence over the stored value. Remove it from that file to manage the setting from here.") }}</td>
                        </tr>
                        <tr>
                            <th scope="row"><span class="ui grey label">{{ _T("unknown") }}</span></th>
                            <td class="back">{{ _T("A row found in database that Galette does not describe. It may come from an older version, or from a plugin that is no longer active.") }}</td>
                        </tr>
                        <tr>
                            <th scope="row"><span class="ui teal label">{{ _T("plugin name") }}</span></th>
                            <td class="back">{{ _T("Declared by that plugin rather than by Galette. Deactivate the plugin and the setting becomes unknown again, keeping its value until the plugin comes back.") }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
{% endblock %}

{% block javascripts %}
        <script type="text/javascript">
            // Filter rows on the setting name, so the page stays usable with
            // more than a hundred of them. Without JS the whole list shows.
            document.getElementById('config_filter').addEventListener('input', function () {
                var needle = this.value.toLowerCase();
                document.querySelectorAll('#advanced_config tbody tr').forEach(function (row) {
                    var name = row.getAttribute('data-name').toLowerCase();
                    row.hidden = needle !== '' && name.indexOf(needle) === -1;
                });
            });

            // _bind_legend() is only called from the lists layout, which this
            // page does not extend
            $(function() {
                _bind_legend();
            });

            // A jump from the constants table must not land on a row the
            // filter is hiding. Without JS there is no filter, so no guard.
            var _revealTarget = function () {
                if (!window.location.hash) {
                    return;
                }
                var filter = document.getElementById('config_filter');
                if (filter.value !== '') {
                    filter.value = '';
                    filter.dispatchEvent(new Event('input'));
                }
                var row = document.getElementById(window.location.hash.slice(1));
                if (row) {
                    row.scrollIntoView({ block: 'center' });
                }
            };
            window.addEventListener('hashchange', _revealTarget);
            $(_revealTarget);
        </script>
{% endblock %}
