{% extends 'page.html.twig' %}

{% block content %}
        <div class="ui warning message">
            <div class="header">{{ _T("Write these codes down now") }}</div>
            <p>{{ _T("They are shown this once and cannot be displayed again. Each one works a single time, and lets you log in when you no longer have your device.") }}</p>
        </div>

        <ul class="ui list" id="tfa_recovery_codes">
    {% for code in codes %}
            <li><code>{{ code }}</code></li>
    {% endfor %}
        </ul>

        <a href="{{ url_for('two-factor-manage') }}" class="ui primary button">
            <i class="check icon" aria-hidden="true"></i>
            {{ _T("I have written them down") }}
        </a>
{% endblock %}
