{% extends (mode == 'ajax') ? "ajax.html.twig" : "page.html.twig" %}

{% block content %}
    <form action="{{ url_for('doEditPaymentType', {'id': ptype.__get('id')}) }}" method="post" class="ui form">
    {% if mode != 'ajax' %}
        <div class="ui segment" id="general">
    {% endif %}
            <div class="required field inline">
                <label for="name">{{ _T("Name:") }}</label>
                <div class="ui right corner labeled input">
                    <div class="ui corner label">
                        {% include "components/forms/tip.html.twig" with {
                            tip: _T("Original string for name, that will be used for translations."),
                            id: "name",
                            small: false,
                            link: true
                        } only %}
                    </div>
                    <input type="text" name="name" id="name" value="{{ ptype.__get('name') }}" required="required" aria-describedby="name-tip" />
                </div>
            </div>
    {% if mode != 'ajax' %}
        </div>
        <div class="ui basic center aligned segment">
            <button type="submit" class="ui labeled icon primary button action">
                <i class="save icon" aria-hidden="true"></i> {{ _T("Save") }}
            </button>
            <input type="submit" name="cancel" value="{{ _T("Cancel") }}" class="ui button"/>
    {% endif %}
            <input type="hidden" name="id" id="id" value="{{ ptype.__get('id') }}"/>
    {% if mode != 'ajax' %}
        </div>
    {% endif %}
     </form>
{% endblock %}
