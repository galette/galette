{% extends 'page.html.twig' %}

{% block content %}
    <form action="{{ url_for('doAdminTools') }}" method="post" class="ui form">
        <div class="ui icon yellow icon message with-transition">
            <i class="exclamation triangle icon" aria-hidden="true"></i>
            <div class="content">
                {{ _T("Make sure you've done a backup of the database before using any of the following tools!") }}
            </div>
        </div>
        <div class="ui top attached accordion-styled header">
            {{ _T('Select actions(s)') }}
        </div>
        <div class="ui bottom attached accordion-styled segment">
            <div class="active content field">
                <div class="field inline">
                    <div class="ui toggle checkbox">
                        {% set reset_texts_tip = _T('Reset all emails contents to their default values') %}
                        <input type="checkbox" name="inittexts" id="inittexts" aria-describedby="inittexts-tip"/>
                        <label for="inittexts" title="{{ reset_texts_tip }}">
                            {{ _T('Reset emails contents') }}
                            {% include "components/forms/tip.html.twig" with {
                                tip: reset_texts_tip,
                                text: false
                            } only %}
                            <span class="field-description">{{ _T('(all existing values will be removed)') }}</span>
                        </label>
                        {% include "components/forms/tip.html.twig" with {
                            tip: reset_texts_tip,
                            id: "inittexts",
                            icon: false
                        } only %}
                    </div>
                </div>
                <div class="field inline">
                    <div class="ui toggle checkbox">
                        {% set reset_fields_tip %}{{ _T('Reset all emails contents to their default values') }}<br/>{{ _T('This includes fields positions, order, visibility, access levels and mandatory marks.') }}{% endset %}
                        <input type="checkbox" name="initfields" id="initfields" aria-describedby="initfields-tip"/>
                        <label for="initfields" title="{{ _T('Reset all emails contents to their default values') }}">
                            {{ _T('Reset fields configuration') }}
                            {% include "components/forms/tip.html.twig" with {
                                tip: reset_fields_tip,
                                html: true,
                                text: false
                            } only %}
                            <span class="field-description">{{ _T('(all existing values will be removed)') }}</span>
                        </label>
                        {% include "components/forms/tip.html.twig" with {
                            tip: reset_fields_tip,
                            id: "initfields",
                            html: true,
                            icon: false
                        } only %}
                    </div>
                </div>
                <div class="field inline">
                    <div class="ui toggle checkbox">
                        {% set reset_models_tip = _T('Reset all PDF models to their default values') %}
                        <input type="checkbox" name="initpdfmodels" id="initpdfmodels" aria-describedby="initpdfmodels-tip"/>
                        <label for="initpdfmodels" title="{{ reset_models_tip }}">
                            {{ _T('Reinitialize PDF models') }}
                            {% include "components/forms/tip.html.twig" with {
                                tip: reset_models_tip,
                                text: false
                            } only %}
                            <span class="field-description">{{ _T('(all existing values will be removed)') }}</span>
                        </label>
                        {% include "components/forms/tip.html.twig" with {
                            tip: reset_models_tip,
                            id: "initpdfmodels",
                            icon: false
                        } only %}
                    </div>
                </div>
                <div class="field inline">
                    <div class="ui toggle checkbox">
                        {% set empty_logins_tip = _T('Fill all empty login and passwords') %}
                        <input type="checkbox" name="emptylogins" id="emptylogins" aria-describedby="emptylogins-tip"/>
                        <label for="emptylogins" title="{{ empty_logins_tip }}">
                            {{ _T('Generate empty logins and passwords') }}
                            {% include "components/forms/tip.html.twig" with {
                                tip: empty_logins_tip,
                                text: false
                            } only %}
                        </label>
                        {% include "components/forms/tip.html.twig" with {
                            tip: empty_logins_tip,
                            id: "emptylogins",
                            icon: false
                        } only %}
                    </div>
                </div>
                <div class="field inline">
                    <div class="ui toggle checkbox">
                        {% set dynamic_dates_tip = _T('Fix dynamic fields dates format') %}
                        <input type="checkbox" name="dynamicdates" id="dynamicdates" aria-describedby="dynamicdates-tip"/>
                        <label for="dynamicdates" title="{{ dynamic_dates_tip }}">
                            {{ _T('Fix dynamic fields dates format') }}
                            {% include "components/forms/tip.html.twig" with {
                                tip: dynamic_dates_tip,
                                text: false
                            } only %}
                        </label>
                        {% include "components/forms/tip.html.twig" with {
                            tip: dynamic_dates_tip,
                            id: "dynamicdates",
                            icon: false
                        } only %}
                    </div>
                </div>

            </div>
        </div>
        <div class="ui basic center aligned segment">
            <button type="submit" class="ui labeled icon primary button action">
                <i class="database icon" aria-hidden="true"></i>
                {{ _T('Go') }}
            </button>
        </div>
    </form>
{% endblock %}
