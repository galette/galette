{% extends 'page.html.twig' %}

{% block content %}
    <h2>
        {{ name }} <code>{{ version }} - {{ date }}</code>
        <br/><span class="author">
            {{ _T("By %1$s")|format(author) }}
        </span>
    </h2>
    {% if module is defined %}
    <dl>
        <dt><strong>{{ _T('Name:') }}</strong></dt>
        <dd>{{ module.name }}</dd>
        <dt><strong>{{ _T('Description:') }}</strong></dt>
        <dd>{{ module.desc }}</dd>
        <dt><strong>{{ _T('Version:') }}</strong></dt>
        <dd>{{ module.version }}</dd>
        <dt><strong>{{ _T('Date:') }}</strong></dt>
        <dd>{{ module.date }}</dd>
        <dt><strong>{{ _T('Author:') }}</strong></dt>
        <dd>{{ module.author }}</dd>
        <dt><strong>{{ _T('Path:') }}</strong></dt>
        <dd>{{ module.root }}</dd>
        <dt><strong>{{ _T('Main route:') }}</strong></dt>
        <dd>{{ module.route }}</dd>
        <dt><strong>{{ _T('Releases repository:') }}</strong></dt>
        <dd>
            <a href="https://github.com/{{ module.repository }}" target="_blank" rel="noopener">{{ module.repository }}</a>
        {% if release_update ?? null %}
            <a
                href="{{ release_update.url }}"
                class="ui mini orange label"
                target="_blank"
                rel="noopener"
                title="{{ _T("Check its compatibility with your Galette version before upgrading.") }}"
            >{{ _T("New version: %1$s")|format(release_update.latest) }}</a>
        {% elseif (release_status ?? null) and release_status.status == constant('Galette\\Util\\Release::STATUS_NOT_FOUND') %}
            <br/>
            <i class="ui question circle grey icon" aria-hidden="true"></i>
            {{ _T("Unable to check for new releases: no release found in %1$s repository.")|format(module.repository) }}
            {{ _T("If the plugin is published elsewhere, its repository must be declared in its _define.php file.") }}
        {% endif %}
        </dd>
        <dt><strong>{{ _T('ACLs') }}</strong>
        <dd>
            <table>
                <thead>
                    <th scope="col">{{ _T('Route') }}</th>
                    <th scope="col">{{ _T('ACL') }}</th>
                </thead>
       {% for route, acl in module.acls %}
                <tr>
                    <td><code>{{ route }}</code></td>
                    <td><code>{{ acl }}</code></td>
                </tr>
        {% else %}
                <td colspan="2"><strong>{{ _T('No ACLs!') }}</strong></td>
        {% endfor %}
            </table>
        </dd>
    </dl>

    <h3>{{ _T('Raw information') }}</h3>
    <pre>{{ module|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
    {% endif %}
{% endblock %}
