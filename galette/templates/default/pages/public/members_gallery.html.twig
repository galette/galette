{% extends 'pages/public/gallery.html.twig' %}

{% block infoline %}
    {% set infoline = {
        'label': _Tn("%1$s member", "%1$s members", nb_members)|format(nb_members),
        'route': {
            'name': 'filterPublicMembersGallery'
        }
    } %}
    {{ parent() }}
{% endblock %}

{% block body %}
    {% if nb_members > 0 %}
        {% for member in members.staff %}
            {{ _self.drawEntry(member) }}
        {% endfor %}
        {% for member in members.members %}
            {{ _self.drawEntry(member) }}
        {% endfor %}
    {% else %}
        <div class="ui small message">
            <div class="content">
                <em>{{ _T('No member') }}</em>
            </div>
        </div>
    {% endif %}
{% endblock %}
