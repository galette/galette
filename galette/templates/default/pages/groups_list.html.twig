{% extends 'elements/list.html.twig' %}

{% set can_export = login.isGroupManager() and preferences.pref_bool_groupsmanagers_exports or login.isAdmin() or login.isStaff() %}
{% set can_edit = login.isGroupManager() and preferences.pref_bool_groupsmanagers_edit_groups or login.isAdmin() or login.isStaff() %}

{% if can_edit %}
    {% set form = {
        'route': {
            'name': "reorderGroups"
        }
    } %}
{% endif %}

{% set columns = [
    {
        'label': _T("Name")
    }
] %}

{% macro group_item(login, can_export, can_edit, group, level, parent_id) %}
    <tr data-label="{{ group.getName() }}" data-group="{{ group.getId() }}" data-orig-parent="{{ parent_id }}" data-parent="{{ parent_id }}" data-managed="{% if login.isGroupManager(group.getId()) %}1{% else %}0{% endif %}">
        <td class="left{% if login.isGroupManager(group.getId()) and preferences.pref_bool_groupsmanagers_edit_groups or login.isAdmin() or login.isStaff() %} drag-handle{% endif %}" data-col-label="{{ _T("Field name") }}">
            {% for i in 0..level %}{% if not loop.first %}<i class="icon group-indent" aria-hidden="true"></i>{% endif %}{% endfor %}
            {% if login.isGroupManager(group.getId()) and preferences.pref_bool_groupsmanagers_edit_groups or login.isAdmin() or login.isStaff() %}
                <i class="arrows alternate icon" aria-hidden="true"></i>
            {% elseif login.isGroupManager() and not preferences.pref_bool_groupsmanagers_edit_groups %}
                {% if level >= '1' %}
                    <i class="chevron left icon" aria-hidden="true" style="transform:rotate(-45deg);"></i>
                {% endif %}
            {% else %}
                <i class="arrows alternate disabled icon" aria-hidden="true"></i>
            {% endif %}
            {{ group.getName() }}
        </td>
        <td class="center actions_row collapsing">
            {% if login.isGroupManager(group.getId()) and can_export %}
                <a href="{{ url_for("pdf_groups", {"id": group.getId()}) }}">
                    <i class="file pdf green icon tooltip" aria-hidden="true"></i>
                    <span class="ui special popup">{{ _T("Export as PDF") }}</span>
                </a>
            {% endif %}
            {% if login.isGroupManager(group.getId()) %}
                <a href="{{ url_for("editGroup", {"id": group.getId()}) }}">
                    <i class="ui {% if can_edit %}edit{% else %}eye outline{% endif %} icon tooltip" aria-hidden="true"></i>
                    <span class="ui special popup">{% if can_edit %}{{ _T("Edit") }}{% else %}{{ _T("Display") }}{% endif %}</span>
                </a>
            {% endif %}
            {% if login.isAdmin() or login.isStaff() %}
                <a href="{{ url_for("removeGroup", {"id": group.getId()}) }}" class="delete">
                    <i class="ui trash red icon tooltip" aria-hidden="true"></i>
                    <span class="ui special popup">{{ _T("Delete") }}</span>
                </a>
            {% endif %}
        </td>
    </tr>
    {% if group.getGroups()|length > 0 %}
        {% set sublevel = level + 1 %}
        {% for child_group in group.getGroups() %}
            {% set level = child_group.getParents()|length %}
            {{ _self.group_item(login, can_export, can_edit, child_group, level, group.getId()) }}
        {% endfor %}
    {% endif %}
{% endmacro %}

{% block content %}
    <noscript>
        <div class="ui basic fitted center aligned segment">
            <div class="ui compact message">{{ _T("This feature requires javascript.") }}</div>
        </div>
    </noscript>

    {{ parent() }}
{% endblock %}

{% block infoline %}
    {% set infoline = {
        'label': login.isAdmin() or login.isStaff() ? _Tn("%1$s entry", "%1$s entries", nb)|format(nb) : _Tn("%1$s managed group", "%1$s managed groups", nb)|format(nb)
    } %}
    {{ parent() }}
{% endblock %}

{% block infoline_actions %}
    {% if can_export or login.isAdmin() or login.isStaff() %}
        {% if can_export %}
            <a href="{{ url_for("pdf_groups") }}" class="ui tiny labeled icon button tooltip" title="{{ _T("Export all groups and their members as PDF") }}">
                <i class="file pdf red labeled icon" aria-hidden="true"></i>
                {{ _T("All groups PDF") }}
            </a>
        {% endif %}
        {% if login.isAdmin() or login.isStaff() %}
            <a href="{{ url_for("add_group", {"name": "NAME"}) }}" class="ui tiny labeled icon button tooltip" id="newgroup">
                <i class="plus circle green icon" aria-hidden="true"></i>
                {{ _T("New group") }}
            </a>
        {% endif %}
    {% endif %}
{% endblock %}

{% block header %}
    {{ parent() }}
{% endblock %}

{% block extra_header %}
    {% if can_edit %}
        <tr>
            <th class="blue " colspan="3" style="padding-top:2px;padding-bottom:4px;" scope="colgroup">
                <span class="ui small text"><i class="info icon"></i> {{ _T("Move an item at the top of the list to reset its parent") }}</span>
            </th>
        </tr>
    {% endif %}
{% endblock %}

{% block body %}
    {% for group in groups_root %}
        {% set level = group.getParents()|length %}
        {{ _self.group_item(login, can_export, can_edit, group, level, 0) }}
    {% endfor %}
{% endblock %}

{% block extra_form %}
    {% if can_edit %}
        <div class="ui basic center aligned segment">
            <button type="submit" class="ui labeled icon primary button action">
                <i class="save icon" aria-hidden="true"></i> {{ _T("Save") }}
            </button>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    <script type="module">
        {% if can_edit %}
            // Selecting necessary DOM elements
            const listForm = document.getElementById('listform');
            const listedGroups = document.getElementById('listed_groups');
            const tableFooter = document.getElementsByTagName('tfoot')[0];
            const submitButton = listForm.querySelector('button[type="submit"]');

            // Arrays and variables to keep track of row children and indentations
            let children = [];
            let origItemIndents = null;
            let newItemIndents = null;
            let diffIndents = null;

            /**
             * Counts the number of indent elements in the first cell of a row.
             * @param {HTMLElement} row - The row element to count indents in.
             * @returns {number} The number of indent elements.
             */
            function countIndents(row) {
                return row.cells[0] ? row.cells[0].children.length : 0;
            }

            /**
             * Updates the indent elements in the first cell of a row.
             * @param {HTMLElement} elt - The row element to update indents for.
             * @param {number} nb - The new number of indent elements.
             */
            function updateIndents(elt, nb) {
                // Remove existing indents
                const eltIndents = elt.cells[0].getElementsByClassName('group-indent');
                Array.from(eltIndents).forEach(child => {
                    elt.cells[0].removeChild(child);
                });
                // Add new indents
                for (let i = 1; i < nb; i++) {
                    const indent = document.createElement('i');
                    indent.setAttribute('class', 'icon group-indent');
                    indent.setAttribute('aria-hidden', 'true');
                    elt.cells[0].insertAdjacentElement('afterbegin', indent);
                }
            }

            /**
             * Selects child rows of a given row and hides them.
             * @param {HTMLElement} row - The row element to select children from.
             */
            function selectChildren(row) {
                children = [];
                origItemIndents = null;
                newItemIndents = null;
                diffIndents = null;
                const indentsCount = countIndents(row);
                let nextRow = row.nextElementSibling;
                // Select children until a row with fewer indents is encountered
                while (nextRow) {
                    const nextRowIndentsCount = countIndents(nextRow);
                    if (nextRowIndentsCount > indentsCount) {
                        children.push(nextRow);
                        nextRow.classList.add('visually-hidden');
                    } else {
                        // Exit the loop if the indents are not greater
                        break;
                    }
                    nextRow = nextRow.nextElementSibling;
                }
                // Remove the selected children from the list
                children.forEach((child) => {
                    listedGroups.removeChild(child);
                });
            }

            /**
             * Creates a hidden input element.
             * @param {string} name - The name attribute of the input element.
             * @param {string} value - The value attribute of the input element.
             * @returns {HTMLElement} The created input element.
             */
            function createHiddenInput(name, value) {
                const input = document.createElement('input');
                input.setAttribute('type', 'hidden');
                input.setAttribute('name', name);
                input.setAttribute('value', value);
                return input;
            }

            /**
             * Creates a warning message in the table footer.
             * @returns {HTMLElement} The table footer element with the warning message.
             */
            function createTableFooterWarning() {
                const tfootRow = document.createElement('tr');
                const tfootCell = document.createElement('th');
                const warningIcon = document.createElement('i');
                const warningMessage = document.createTextNode(
                    ' ' + '{{ _T("Some of the changes you made (highlighted in red above) are not allowed. Saving your changes in the list will only be possible if all of them are allowed.")|e("js") }}'
                );
                warningIcon.setAttribute('class', 'exclamation triangle icon');
                tfootCell.setAttribute('class', 'yellow');
                tfootCell.setAttribute('colspan', '3');
                tfootCell.setAttribute('scope', 'colgroup');
                tableFooter.appendChild(tfootRow);
                tfootRow.appendChild(tfootCell);
                tfootCell.appendChild(warningIcon);
                tfootCell.appendChild(warningMessage);
                return tableFooter;
            }

            /**
             * Creates a warning message when changes must be saved.
             * @returns {HTMLElement} The warning message element.
             */
            function createSaveWarning() {
                const messageContainer = document.createElement('div');
                const contentContainer = document.createElement('div');
                const warningIcon = document.createElement('i');
                const warningMessage = document.createTextNode(
                    '{{ _T("Items in this list have been modified. Don't forget to save your changes.")|e('js') }}'
                );
                warningIcon.setAttribute('class', 'exclamation triangle icon');
                contentContainer.setAttribute('class', 'content');
                messageContainer.setAttribute('class', 'ui icon yellow message with-transition');
                messageContainer.setAttribute('id', 'save_warning');
                listForm.insertAdjacentElement('beforebegin', messageContainer);
                messageContainer.appendChild(warningIcon);
                messageContainer.appendChild(contentContainer);
                contentContainer.appendChild(warningMessage);
                return messageContainer;
            }

            /**
             * Initializes the sortable functionality for the listed groups.
             */
            function initSortable() {
                new Sortable(listedGroups, {
                    group: 'lists',
                    handle: '.drag-handle',
                    animation: 150,
                    ghostClass: 'yellow',
                    onChoose: function (evt) {
                        // Select children when an item is chosen
                        selectChildren(evt.item);
                        // Store original indents
                        origItemIndents = countIndents(evt.item);
                    },
                    onUnchoose: function(evt) {
                        // Reinsert the children after the item is unchosen
                        const item = evt.item;
                        children.reverse();
                        children.forEach((child) => {
                            child.classList.remove('visually-hidden');
                            updateIndents(child, countIndents(child) + diffIndents);
                            item.insertAdjacentElement('afterend', child);
                        });
                    },
                    onChange: function (evt) {
                        // Update the indents while moving the item in the list
                        const index = evt.newIndex;
                        const item = listedGroups.children[index];
                        const newParent = listedGroups.children[index - 1];
                        if (newParent === undefined) {
                            newItemIndents = 1;
                        } else {
                            newItemIndents = countIndents(newParent) + 1;
                        }
                        diffIndents = newItemIndents - origItemIndents;
                        updateIndents(item, newItemIndents);
                    },
                    onEnd: function (evt) {
                        const item = evt.item;
                        const newParent = item.previousElementSibling != null ? item.previousElementSibling.dataset.group : 0;
                        const newParentIsManaged = item.previousElementSibling != null ? item.previousElementSibling.dataset.managed : 1;
                        const existingInput = item.getElementsByTagName('input')[0];
                        // Remove existing input if found
                        if (existingInput) {
                            existingInput.remove();
                        }
                        item.dataset.parent = newParent;
                        const groupId = item.dataset.group;
                        const parentId = item.dataset.parent;
                        const origParentId = item.dataset.origParent;
                        // Add the hidden input to the item and set the appropriate class
                        if (newParentIsManaged == 1 || parentId == origParentId) {
                            // Change in the list is allowed
                            const hiddenInput = createHiddenInput('reordered[]', groupId + '|' + parentId);
                            item.classList.add('yellow');
                            item.insertAdjacentElement('beforeend', hiddenInput);
                        } else {
                            // Change in the list is not allowed
                            const hiddenInput = createHiddenInput('unallowed[]', groupId + '|' + parentId);
                            item.classList.add('red');
                            item.insertAdjacentElement('beforeend', hiddenInput);
                        }
                        // Check for unallowed changes and update the footer warning
                        const unallowedChanges = document.getElementsByName('unallowed[]');
                        const existingWarning = tableFooter.getElementsByTagName('tr')[0];
                        if (unallowedChanges.length > 0) {
                            if (existingWarning == null) {
                                // Create warning if it doesn't exist and changes in the list are not allowed
                                const warningInFooter = createTableFooterWarning();
                                listedGroups.insertAdjacentElement('afterend', warningInFooter);
                            }
                            // Disable the submit button
                            submitButton.setAttribute('disabled', 'true');
                        } else {
                            if (existingWarning != null) {
                                // Remove existing warning if all changes in the list are allowed
                                existingWarning.remove();
                            }
                            // Enable the submit button
                            submitButton.removeAttribute('disabled');
                        }
                        // Inform the user about unsaved changes
                        const existingSaveWarning = document.getElementById('save_warning');
                        if (existingSaveWarning == null) {
                            createSaveWarning();
                            $('.message.with-transition').transition('flash');
                        }
                    }
                });
            }
        {% endif %}

        $(function() {
            {% if login.isAdmin() or login.isStaff() %}
                {# New group #}
                $('#newgroup').click(function(){
                    var _href = $(this).attr('href');
                    var _input = '<div class="ui labeled input"><div class="ui label">{{ _T("Name:") }}</div><input type="text" name="new_group_name" id="new_group_name" required/></div>';
                    $('body').modal({
                        title: '{{ _T("Add a new group") }}',
                        class: 'tiny',
                        content: _input,
                        onApprove: function() {
                            var _name = $('#new_group_name').val();
                            if ( _name != '' ) {
                                //check uniqueness
                                $.ajax({
                                    url: '{{ url_for("ajax_groupname_unique") }}',
                                    type: "POST",
                                    data: {
                                        ajax: true,
                                        gname: _name
                                    },
                                    {% include "elements/js/loader.js.twig" with {
                                        selector: ".segment:not(.tab).loader_selector",
                                        loader: "button"
                                    } %},
                                    success: function(res){
                                        if ( res.success == false ) {
                                            if (res.message) {
                                                {% include "elements/js/modal.js.twig" with {
                                                    modal_title_twig: _T("An error occurred :(")|e("js"),
                                                    modal_content: "res.message",
                                                    modal_class: "tiny",
                                                    modal_content_class: "scrolling",
                                                    modal_deny_only: true,
                                                    modal_cancel_text: _T("Close")|e("js"),
                                                    modal_classname: "redalert",
                                                } %}
                                            } else {
                                                {% include "elements/js/modal.js.twig" with {
                                                    modal_title_twig: _T("The group name you have requested already exists in the database.")|e("js"),
                                                    modal_without_content: true,
                                                    modal_class: "mini",
                                                    modal_deny_only: true,
                                                    modal_cancel_text: _T("Close")|e("js"),
                                                    modal_classname: "redalert",
                                                } %}
                                            }
                                        } else {
                                            $(location).attr('href', _href.replace('NAME', _name));
                                        }
                                    },
                                    error: function() {
                                        {% include "elements/js/modal.js.twig" with {
                                            modal_title_twig: _T("An error occurred checking name uniqueness :(")|e("js"),
                                            modal_without_content: true,
                                            modal_class: "mini",
                                            modal_deny_only: true,
                                            modal_cancel_text: _T("Close")|e("js"),
                                            modal_classname: "redalert",
                                        } %}
                                    }
                                });
                            } else {
                                {% include "elements/js/modal.js.twig" with {
                                    modal_title_twig: _T("Please provide a group name")|e("js"),
                                    modal_without_content: true,
                                    modal_class: "mini",
                                    modal_deny_only: true,
                                    modal_cancel_text: _T("Close")|e("js"),
                                    modal_classname: "redalert",
                                } %}
                                return false;
                            }
                        },
                        actions: [{
                            text    : '{{ _T("Create")|e('js') }}',
                            icon    : 'plus',
                            class   : 'icon labeled green approve'
                        },{
                            text    : '{{ _T("Close")|e('js') }}',
                            icon    : 'times',
                            class   : 'icon labeled deny'
                        },]
                    }).modal('show');
                    return false;
                });

                {% include "elements/js/removal.js.twig" with {
                    single_action: "true"
                } %}
            {% endif %}

            {% if can_edit %}
                initSortable();
            {% endif %}
        });
    </script>
{% endblock %}
