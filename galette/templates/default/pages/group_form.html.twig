{% extends "page.html.twig" %}

{% set can_export = login.isGroupManager() and preferences.pref_bool_groupsmanagers_exports or login.isAdmin() or login.isStaff() %}

{% block content %}
    {% include "elements/group.html.twig" with {"group": group, "parent_groups": parent_groups} %}
{% endblock %}

{% block javascripts %}
<script type="text/javascript">
    {% include "elements/js/members_selection.js.twig" %}
    {% include "elements/js/group_persons_modal.js.twig" %}

    $(function() {
        {# Members and managers selection #}
        $('#btnusers_small, #btnmanagers_small').on('click', function(event){
            {# the button lives in the accordion's title, do not toggle it #}
            event.stopPropagation();

            var _button = $(this);
            var _mode = _button.data('mode');
            var _container = (_mode === 'managers') ? $('#group_managers') : $('#group_members');

            galetteManageGroupPersons({
                manageTitle: (_mode === 'managers')
                    ? '{{ _T("Group managers selection")|e('js') }}'
                    : '{{ _T("Group members selection")|e('js') }}',
                storeUrl: _button.data('store-url'),
                listData: {
                    from: 'groups',
                    gid: _button.data('group'),
                    mode: _mode
                },
                loaderFrom: '#' + _button.attr('id'),
                onStored: function(res) {
                    _container.find('.loader_selector').replaceWith(res.html);
                    _container.find('.persons-count').text(res.count);
                }
            });

            return false;
        });
    });
</script>
{% endblock %}
