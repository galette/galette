{% extends 'elements/list.html.twig' %}

{% set form = {
    'order': {
        'name': "documentsList",
    }
} %}

{% set columns = [
    {
        'label': _T('ID'),
        'collapse': true
    },
    {
        'label': _T("Filename")
    },
    {
        'label': _T('Type')
    },
    {
        'label': _T('Visibility')
    },
    {
        'label': _T("Creation date"),
        'collapse': true
    }
] %}

{% block infoline %}
    {% set infoline = {
        'label': _Tn("%1$s document", "%1$s documents", nb)|format(nb)
    } %}
    {{ parent() }}
{% endblock %}

{% block infoline_actions %}
    {% if not is_public and (login.isAdmin() or login.isStaff()) %}
        <a
            class="ui tiny labeled icon button"
            href="{{ url_for("addDocument") }}"
        >
            <i class="plus circle green icon" aria-hidden="true"></i>
            {{ _T("Add a document") }}
        </a>
    {% endif %}
{% endblock %}

{% block header %}
    {{ parent() }}
{% endblock %}

{% block body %}
    {% for document in documents %}
        <tr class="" id="row_{{ document.id }}">
            <td class="collapsing" data-scope="row" data-col-label="{{ _T('ID') }}">
                {{ document.id }}
            </td>
            <td data-col-label="{{ _T("Filename") }}">
                <a href="{{ url_for('getDocumentFile', {'id': document.getID()}) }}">
                    {{ document.getDocumentFilename() }}
                </a>
            </td>
            <td data-col-label="{{ _T("Type") }}">{{ _T(document.getType()) }}</td>
            <td data-col-label="{{ _T("Visibility") }}">{{ document.getPermissionName() }}</td>
            <td class="collapsing" data-col-label="{{ _T("Creation date") }}">{{ document.getCreationDate() }}</td>
            {% if mode != 'ajax' %}
                <td class="actions_row center collapsing">
                    <a
                            href="{{ url_for("editDocument", {"id": document.getID()}) }}"
                            class="action icon-only"
                    >
                        <i class="ui edit icon" aria-hidden="true"></i>
                        <span class="visually-hidden">{{ _T("Edit document") }}</span>
                    </a>
                    <a
                            href="{{ url_for("removeDocument", {"id": document.getID()}) }}"
                            class="delete icon-only"
                    >
                        <i class="ui trash red icon" aria-hidden="true"></i>
                        <span class="visually-hidden">{{ _T("Delete document") }}</span>
                    </a>
                </td>
            {% endif %}
        </tr>
    {% else %}
        <tr><td colspan="{{ columns_count }}" class="emptylist">{{ _T("No document") }}</td></tr>
    {% endfor %}
{% endblock %}
