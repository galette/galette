msgid "from member %id_adh"
msgstr "உறுப்பினரிடமிருந்து %id_adh"

msgid "Email address %address is already used! (%extra)"
msgstr "மின்னஞ்சல் முகவரி %address ஏற்கனவே பயன்படுத்தப்பட்டுள்ளது! (%extra)"

msgid "Lang %lang does not exists!"
msgstr "லாங் %lang இல்லை!"

msgid "File is empty!"
msgstr "கோப்பு காலியாக உள்ளது!"

#. TRANS: first parameter is row, second member name
