#, php-format
msgid "Association %s"
msgstr "சங்கம் %s"

msgid "An error occurred."
msgstr "பிழை ஏற்பட்டது."

msgid ""
"File name is invalid, it should not contain any special character or space."
msgstr "கோப்பு பெயர் தவறானது, அதில் எந்த சிறப்பு எழுத்து அல்லது இடமும் இருக்கக்கூடாது."

#, php-format
msgid "File extension is not allowed, only %s files are."
msgstr "கோப்பு நீட்டிப்பு அனுமதிக்கப்படவில்லை, %s கோப்புகள் மட்டுமே."

#, php-format
msgid "File is too big. Maximum allowed size is %dKo"
msgstr "கோப்பு மிகப் பெரியது. அதிகபட்சமாக அனுமதிக்கப்பட்ட அளவு %dko ஆகும்"

#, php-format
msgid "Image is too small. The minimum image side size allowed is %spx"
msgstr "படம் மிகவும் சிறியது. அனுமதிக்கப்பட்ட குறைந்தபட்ச பட பக்க பக்க அளவு %sPX ஆகும்"

msgid "Mime-Type not allowed"
msgstr "மைம்-வகை அனுமதிக்கப்படவில்லை"

msgid "A file with that name already exists!"
msgstr "அந்த பெயருடன் ஒரு கோப்பு ஏற்கனவே உள்ளது!"

msgid "File does not comply with requirements."
msgstr "கோப்பு தேவைகளுக்கு இணங்காது."

msgid "Unable to write file or temporary file"
msgstr "கோப்பு அல்லது தற்காலிக கோப்பை எழுத முடியவில்லை"

msgid "The uploaded file exceeds the upload_max_filesize directive in php.ini"
msgstr "பதிவேற்றிய கோப்பு php.ini இல் உள்ள பதிவேற்றம்_மாக்ச்_பைல்ச்ச் டைரெக்டிவ் மீறுகிறது"

msgid ""
"The uploaded file exceeds the MAX_FILE_SIZE directive that was specified in "
"the HTML form"
msgstr ""
"பதிவேற்றிய கோப்பு உஉகுமொ படிவத்தில் குறிப்பிடப்பட்டுள்ள MAX_FILE_SIZE உத்தரவை மீறுகிறது"

msgid "The uploaded file was only partially uploaded"
msgstr "பதிவேற்றிய கோப்பு ஓரளவு மட்டுமே பதிவேற்றப்பட்டது"

msgid "No file was uploaded"
msgstr "எந்த கோப்பும் பதிவேற்றப்படவில்லை"

msgid "Missing a temporary folder"
msgstr "ஒரு தற்காலிக கோப்புறையைக் காணவில்லை"

msgid "Failed to write file to disk"
msgstr "வட்டுக்கு கோப்பை எழுதுவதில் தோல்வி"

msgid "File upload stopped by extension"
msgstr "கோப்பு பதிவேற்றம் நீட்டிப்பு மூலம் நிறுத்தப்பட்டது"

msgid "Unknown upload error"
msgstr "தெரியாத பதிவேற்ற பிழை"

msgid "An SQL error has occurred."
msgstr "ஒரு கவிமொ பிழை ஏற்பட்டது."

