#, php-format
msgid "File %1$s cannot be open!"
msgstr "கோப்பு %1$s திறந்திருக்க முடியாது!"

#, php-format
msgid ""
"Fields count mismatch... There should be %1$s fields and there are %2$s (row "
"%3$s)"
msgstr ""
"புலங்கள் பொருந்தாத தன்மையை எண்ணுகின்றன ... %1$s வேண்டிய_கவுண்ட் புலங்கள் இருக்க வேண்டும் "
"மற்றும் %2$s (வரிசை %3$s) இருக்க வேண்டும்"

#. TRANS: first parameter is a field name, second the row in error
#, php-format
msgid "Field %1$s is required, but missing in row %2$s"
msgstr "புலம் %1$s தேவை, ஆனால் வரிசை %2$s காணவில்லை"

#, php-format
