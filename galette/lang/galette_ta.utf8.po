msgid "- Mandatory field %1$s empty."
msgstr "- கட்டாய புலம் %1$s காலியாக உள்ளது."

msgid "Passwords mismatch"
msgstr "கடவுச்சொற்கள் பொருந்தவில்லை"

msgid "You have to select a staff member to retrieve its address"
