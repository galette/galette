msgstr "[{ASSO_NAME}] Нова пожертва для {NAME_ADH}"

msgid ""
"Hello dear Administrator,{NEWLINE}A donation from {NAME_ADH} has been "
"registered{BR}{CONTRIB_INFO}{NEWLINE}Yours sincerly,{BR}Galette"
