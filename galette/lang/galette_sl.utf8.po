"Hello!{NEWLINE}{NAME_ADH} has modified his/her account.{NEWLINE}See you soon!"
"{NEWLINE}(this email was sent automatically)"
msgstr ""
"Pozdravljeni! {NEWLINE}{NAME_ADH} je spremenil/a svoj račun. {NEWLINE}Se "
"vidimo kmalu! {NEWLINE}(to e-poštno sporočilo je bilo poslano samodejno)"

