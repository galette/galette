msgstr "Račun [{ASSO_NAME}] {NAME_ADH} ni aktiven"

msgid ""
"Hello!{NEWLINE}A password recovery request has been made on your account on "
"{ASSO_NAME}, but it is currently inactive and therefore cannot be processed."
