/*******************************
       Galette Overrides
*******************************/

/*----------------------
     Color type input
-----------------------*/
.ui.form .inline.field > input[type=color] {
  padding: 0;
  width: 4rem;
  height: 2rem;
}

/*----------------------
     Search input
-----------------------*/
.ui.form .galetteform .ui.search .ui.input {
  &,
  & input {
    width: 100%;
  }
}

/*----------------------
     Grouped fields
-----------------------*/
.ui.form .galetteform .grouped.fields {
  padding-left: .5em;
  padding-right: .5em;

  &,
  & .field {
    margin: 0;
  }
}

/*----------------------
     Password strength
-----------------------*/
.password-strength {
  margin-top: .5em;

  &[hidden] {
    display: none;
  }
}
.password-strength-summary {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: .3em .7em;
}
.password-strength-bar {
  display: inline-flex;
  gap: 3px;

  span {
    position: relative;
    width: 2.2em;
    height: .4em;
    border-radius: 1em;
    background-color: rgba(0, 0, 0, .1);
  }
  &.bad span.filled { background-color: @red; }
  &.fair span.filled { background-color: @orange; }
  &.good span.filled { background-color: @green; }

  /* required level marker */
  span.threshold::after {
    content: '';
    position: absolute;
    right: -2px;
    top: -.3em;
    bottom: -.3em;
    width: 1px;
    background-color: @mutedTextColor;
  }
}
.password-strength-text {
  display: inline-flex;
  align-items: center;
  gap: .6em;
  font-size: .92em;

  .password-strength-level {
    &.bad { color: @red; }
    &.fair { color: @orange; }
    &.good { color: @green; }
  }
  i.icon {
    margin: 0 .2em 0 0;
  }
}
.password-strength-rules {
  margin: .5em 0 0;
  padding: 0;
  list-style: none;
  font-size: .88em;
  line-height: 1.6;
  color: @mutedTextColor;

  ul {
    margin: 0;
    padding-left: 1.4em;
    list-style: none;
  }
  li.met,
  li.missing {
    color: @textColor;
  }
  i.icon {
    width: 1.2em;
    margin: 0 .2em 0 0;
  }
}
