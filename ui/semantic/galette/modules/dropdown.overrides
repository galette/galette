/*******************************
        Galette Overrides
*******************************/

/*------------------------------
     Compact menu dropdowns
-------------------------------*/
.compact_menu .ui.dropdown .dropdown.icon {
    margin: 0;
    float: none;
    position: absolute;
    right: 5px;
    top: 50%;
    transform: translateY(-50%);
}

/*--------------------------
     Language dropdown
---------------------------*/
.ui.language.dropdown.rtl .menu {
    left: auto;
    right: 0;
}

/*------------------------
     Search dropdown
-------------------------*/
.ui.form .fields .field .ui.input.search input,
.ui.search.selection.dropdown > input.search {
  width: 100%;
}
.ui.search.selection.paginated.dropdown {
    > .ui.mini.button {
        display: none;
    }
    &.visible > .ui.mini.button {
        display: block;
        margin-right: 0;
        //cursor: pointer;
        font-size: .85714286em;
        position: absolute;
        top: .3rem;
        opacity: .6;
        z-index: 3;
        &:hover {
            opacity: 1;
        }
        &.next-results {
            right: 2.5em;
        }
        &.prev-results {
            right: 5em;
        }
    }
    &.visible > .remove.icon {
        right: 8.5em;
    }
}
.ui.search.selection.paginated.dropdown,
.ui.search.selection.paginated.dropdown > input.search {
    padding: .67857143em 6.5em .67857143em 1em;
}

/*--------------------------------
     Button in combo dropdown
---------------------------------*/
.ui.combo.dropdown.button {
    form {
        button.ui.item {
            position: relative;
            cursor: pointer;
            display: block;
            background-color: transparent;
            border: @itemBorder;
            height: @itemHeight;
            min-height: @itemMinHeight;
            text-align: @itemTextAlign;
            border-top: @itemDivider;
            border-radius: 0;
            line-height: @itemLineHeight;
            font-size: @itemFontSize;
            color: @itemColor;
            padding: @itemPadding;
            text-transform: @itemTextTransform;
            font-weight: @itemFontWeight;
            box-shadow: @itemBoxShadow;

            &:hover {
                background: @hoveredItemBackground;
                color: @hoveredItemColor;
                z-index: @hoveredZIndex;
            }

            & > i.icon {
                margin-right: @itemElementDistance;
            }
        }
    }
}
@supports selector(:has(.f)) {
  .ui.combo.pointing.dropdown:not(.upward) .menu:has(form > button:hover)::after {
    background: @white;
  }
}
