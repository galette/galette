#!/usr/bin/env php
<?php

/**
 * This file is part of Galette (https://galette.eu).
 * SPDX-FileCopyrightText: Copyright © 2003-2026 The Galette Team
 * SPDX-License-Identifier: GPL-3.0-or-later
 */

declare(strict_types=1);

use function Safe\define;
use function Safe\session_start;

//relative to this script, not to the current directory, which may be
//anything from a cron job or a script - or another Galette checkout
$basepath ??= \dirname(__DIR__) . '/galette/';

\define('GALETTE_ENV', 'CLI'); //@phpstan-ignore theCodingMachineSafe.function (dependencies not loaded yet)
if (getenv('GALETTE_TESTS')) {
    require_once __DIR__ . '/../tests/test_env.inc.php';
}
//test environment already defines it
if (!\defined('GALETTE_ROOT')) {
    \define('GALETTE_ROOT', \realpath(__DIR__ . '/../galette/') . '/'); //@phpstan-ignore theCodingMachineSafe.function, theCodingMachineSafe.function (dependencies not loaded yet)
}

//specific logfile for console, read back by includes/galette.inc.php through the
//scope of the require below, hence unused as far as the sniff can tell
$logfile = 'galette_cli'; // phpcs:ignore SlevomatCodingStandard.Variables.UnusedVariable.UnusedVariable

require_once $basepath . 'vendor/autoload.php';
require_once $basepath . 'includes/sys_config/versions.inc.php';

// Compiling locales only works on files; boot without database, like the installer.
// Options may come before the command name, look for it rather than at argv[1]
$installer = in_array(
    (new \Symfony\Component\Console\Input\ArgvInput())->getFirstArgument(),
    ['galette:install', 'galette:compile-locales'],
    strict: true
);

// In test mode, GALETTE_CONFIG_PATH is already set to the test config directory,
// so skip the production config file check to allow all commands to be registered.
if (!getenv('GALETTE_TESTS') && ($installer || !file_exists($basepath . 'config/config.inc.php'))) {
    define('GALETTE_INSTALLER', value: true);
    $installer = true; //consider we're installing
} elseif ($installer) {
    define('GALETTE_INSTALLER', value: true);
}
require_once $basepath . 'includes/galette.inc.php';

session_start();
$session_name = 'galette_cli_' . str_replace('.', '_', GALETTE_VERSION);
$session = &$_SESSION['galette'][$session_name]; // phpcs:ignore SlevomatCodingStandard.Variables.UnusedVariable.UnusedVariable

/** @var \Galette\Core\Plugins $plugins */
$gapp = new \Galette\Core\SlimApp($plugins);
$app = $gapp->getApp();
$container = $app->getContainer();

$console = new \Galette\Console\GaletteApplication($basepath);
$console->init(
    $container,
    $app,
    $container->get(\Slim\Routing\RouteCollector::class)
);
$console->run();
