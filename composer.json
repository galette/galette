{
    "name": "galette/galette",
    "description": "Galette - Free your association management! / Libérez la gestion de votre association !",
    "license": "GPLv3",
    "type": "project",
    "keywords": [
        "membership",
        "web",
        "management"
    ],
    "homepage": "https://galette.eu/",
    "support": {
        "irc": "irc://irc.oftc.net/galette",
        "issues": "https://bugs.galette.eu/projects/galette",
        "docs": "https://doc.galette.eu"
    },
    "authors": [
        {
            "name": "Johan Cwiklinski",
            "email": "trasher@x-tnd.be",
            "homepage": "https://galette.eu"
        }
    ],
    "autoload": {
        "files": [
            "galette/includes/functions.inc.php"
        ],
        "psr-4": {
            "Galette\\": "galette/lib/Galette"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Galette\\Tests\\": "tests/lib/"
        }
    },

    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-gettext": "*",
        "ext-mbstring": "*",
        "ext-session": "*",
        "slim/slim": "^4",
        "laminas/laminas-db": "^2.11",
        "laminas/laminas-stdlib": "^3.3",
        "analog/analog": "^1.0",
        "phpmailer/phpmailer": "^7.0",
        "tecnickcom/tcpdf": "^6.6",
        "akrabat/rka-slim-session-middleware": "^3.0",
        "laminas/laminas-i18n": "^2.11",
        "slim/flash": "^0.4.0",
        "league/event": "^3.0",
        "psr/http-message": "^2.0",
        "psr/container": "^1.0",
        "php-di/slim-bridge": "^3",
        "laminas/laminas-servicemanager": "^3.17",
        "symfony/polyfill-php80": "^1.23",
        "ezyang/htmlpurifier": "^4.13",
        "slim/csrf": "^1.3",
        "twig/twig": "^3.3",
        "slim/twig-view": "^3.3",
        "slim/psr7": "^1.6",
        "symfony/yaml": "^6.2",
        "guzzlehttp/guzzle": "^7.8",
        "twig/string-extra": "^3.8",
        "symfony/console": "^7.4",
        "twig/intl-extra": "^3.24",
        "endroid/qr-code": "^6.0",
        "sabre/vobject": "^4.5",
        "league/html-to-markdown": "^5.1",
        "php-di/php-di": "^7.1",
        "psr/http-server-handler": "^1.0",
        "thecodingmachine/safe": "^3.3"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0",
        "friendsoftwig/twigcs": "^6.2",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.5",
        "malukenho/docheader": "^1.0",
        "slevomat/coding-standard": "^8.26",
        "alisqi/twigqi": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "rector/rector": "^2.0",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "thecodingmachine/phpstan-safe-rule": "^1.4",
        "galette/coding-standard": "^1.0",
        "nikic/php-parser": "^5.7"
    },
    "config": {
        "vendor-dir": "galette/vendor/",
        "optimize-autoloader": true,
        "platform-check": false,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "post-install-cmd": [
            "patch -d galette/vendor/tecnickcom/tcpdf/ -p3 < patches/tcpdf-php81.patch"
        ]
    }
}
