parameters:
    reportUnmatchedIgnoredErrors: false
    parallel:
        maximumNumberOfProcesses: 2
    level: 6
    bootstrapFiles:
        - stubs/constants.php
    paths:
        - galette/lib/
        - galette/includes/
        - galette/install/
        - galette/webroot/
        - tests/
    excludePaths:
        # generated at runtime by the test suite (compiled Twig templates,
        # caches, uploads, ...); analysing it reports hundreds of false
        # positives on __TwigTemplate_* classes.
        # (?) marks it optional: it does not exist on a fresh checkout
        - tests/tests-data (?)
    scanFiles:
        - galette/includes/sys_config/paths.inc.php
        - galette/includes/sys_config/versions.inc.php
        - galette/config/config.inc.php.dist
        - galette/includes/sys_config/galette_tcpdf_config.php
    scanDirectories:
        - galette/includes/
    dynamicConstantNames:
        - GALETTE_BASE_PATH
        - GALETTE_ROOT
        - GALETTE_CONFIG_PATH
        - GALETTE_PLUGINS_PATH
        - GALETTE_DATA_PATH
        - GALETTE_THEMES_PATH
        - GALETTE_LOGS_PATH
        - GALETTE_CACHE_DIR
        - GALETTE_EXPORTS_PATH
        - GALETTE_IMPORTS_PATH
        - GALETTE_PHOTOS_PATH
        - GALETTE_DOCUMENTS_PATH
        - GALETTE_ATTACHMENTS_PATH
        - GALETTE_FILES_PATH
        - GALETTE_TEMPIMAGES_PATH
        - GALETTE_TELEMETRY_URI
        - GALETTE_TPL_THEME_DIR
        - GALETTE_DOWNLOADS_URI
        - GALETTE_CRON
        - GALETTE_INSTALLER
        - GALETTE_LOGGER_CHECKED
        - GALETTE_MODE
        - GALETTE_DEBUG
        - GALETTE_LOG_LVL
        - GALETTE_THEME
        - GALETTE_TIMEOUT
        - GALETTE_NIGHTLY
        - _CURRENT_THEME_PATH
        - GALETTE_TESTS_PATH
        - GALETTE_TESTS
        - GALETTE_FEATURE_FLAGS
    universalObjectCratesClasses:
        - RKA\Session
    ignoreErrors:
        - '/Instantiated class XHProfRuns_Default not found/'
        - '/Cannot access property .* on .*ArrayObject.*/'
        - '/Access to an undefined property ArrayObject.*/'
        - '/Access to an undefined property Sabre\\VObject\\Component\\VCard.*/'
        - '/Parameter #3 \$right of class Laminas\\Db\\Sql\\Predicate\\Operator constructor expects bool\|float\|int\|string\|null, Laminas\\Db\\Sql\\Predicate\\Expression given./'
        - '/Cannot unset property .* because it might have hooks in a subclass./'
        - '/Function unserialize is unsafe to use./'
        -
            identifier: theCodingMachineSafe.function
            paths:
                - tests/config/*/galette_tcpdf_config.php
                - tests/config/*/config.inc.php
                - tests/config/*/local_config.inc.php
                - tests/TestsBootstrap.php
includes:
    - galette/vendor/thecodingmachine/phpstan-safe-rule/phpstan-safe-rule.neon

services:
    -
        class: Galette\Tests\PHPStan\RequireEntityConstantRule
        tags:
            - phpstan.rules.rule
