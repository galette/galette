{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2020", "DOM"]
  },
  "include": [
    "playwright.config.ts",
    "tests/e2e/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "galette/vendor"
  ]
}


