{% extends 'page.html.twig' %}

{% block content %}
    {% include "elements/display_dynamic_fields.html.twig" with {object: thing} %}

    {# the edit route is for staff only #}
    {% if login.getAccessLevel() >= constant('Galette\\Core\\Authentication::ACCESS_STAFF') %}
    <div class="ui basic center aligned fitted segment">
        <a href="{{ url_for("plugin1_thing_edit", {"id": thing.getID()}) }}" class="ui labeled icon button">
            <i class="edit icon" aria-hidden="true"></i> {{ _T("Edit") }}
        </a>
    </div>
    {% endif %}
{% endblock %}
